---
// The RootMap tree mark (from the app, RootMapMVP src/components/TreeLogo.tsx) with the wordmark.
interface Props {
  showWordmark?: boolean;
  class?: string;
}
const { showWordmark = true, class: className } = Astro.props;
---

<span class:list={['logo', className]}>
  <svg viewBox="0 0 46 46" width="34" height="34" aria-hidden="true" fill="none">
    <path d="M23 39V19M23 26l-8-7M23 23l8-9M23 30l11-7M17 39h12" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"></path>
    <circle cx="13" cy="16" r="6" fill="currentColor"></circle>
    <circle cx="23" cy="11" r="7" fill="currentColor"></circle>
    <circle cx="33" cy="12" r="6" fill="var(--logo-accent, #d98b62)"></circle>
    <circle cx="36" cy="23" r="5.5" fill="currentColor"></circle>
    <circle cx="15" cy="25" r="5" fill="var(--logo-accent, #d98b62)"></circle>
  </svg>
  {showWordmark && <span class="logo__word">RootMap</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--green-500);
  }
  .logo__word {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--green-700);
    font-variation-settings: 'SOFT' 100;
  }
</style>
