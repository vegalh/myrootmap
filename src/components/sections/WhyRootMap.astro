---
// "Childhood happens in the real world" and the six ideas RootMap cares about. Moved here from the homepage;
// shown on Our Philosophy. Copy: philosophy.why in src/i18n.
import Botanical from '../Botanical.astro';
import Figure from '../Figure.astro';
import GrowOnScroll from './GrowOnScroll.astro';
import { t, type Lang } from '../../i18n';
import { IMAGES } from '../../config/images';
import type { BotanicalName } from '../../illustrations/botanicals';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
const why = copy.philosophy.why;
// The drawing beside each idea, in the order the ideas are written.
const IDEA_ART: BotanicalName[] = ['catTwig', 'catBerries', 'catBud', 'catSeedling', 'catFern', 'catFlower'];
---

  <section class="section why" id="why" aria-labelledby="why-title">
    <div class="container">
      <div class="why__top">
        <div class="why__text">
          <p class="kicker"><Botanical name="sprig" />{why.eyebrow}</p>
          <h2 class="why__title" id="why-title">{why.title}</h2>
          {why.intro.map((p) => <p>{p}</p>)}
        </div>
        <div class="why__collage">
          <Figure class="why__photo" image={IMAGES.homeChildhoodMain} alt={why.imageAlt} caption={why.caption} placeholder={copy.common.imagePlaceholder} />
          <Figure class="why__detail" image={IMAGES.homeChildhoodDetail} alt={why.detailAlt} placeholder={copy.common.imagePlaceholder} />
        </div>
      </div>

      <h3 class="visually-hidden">{why.ideasLabel}</h3>
      <div class="roots">
        <!-- The vine the six ideas grow on: down the middle on wide screens, along the left edge on phones -->
        <svg class="roots__stem" viewBox="0 0 24 800" preserveAspectRatio="none" fill="none" aria-hidden="true">
          <path d="M12 0C5 90 19 180 12 270S6 450 13 540S18 720 11 800"></path>
        </svg>
        <ul class="roots__list" role="list">
          {
            why.ideas.map((idea, i) => (
              <li class="idea">
                <span class="idea__art" aria-hidden="true">
                  <Botanical name={IDEA_ART[i]} class="js-grow" />
                </span>
                <div class="idea__text">
                  <h4>{idea.title}</h4>
                  <p>{idea.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

<GrowOnScroll />

<style>
  /* Shared pieces */
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--green-600);
    font-size: var(--step--1);
    font-weight: 700;
  }
  .kicker :global(.botanical) {
    width: 1.75rem;
    flex-shrink: 0;
    transition: transform 0.5s var(--ease);
    transform-origin: 10% 90%;
  }
  section:hover .kicker :global(.botanical) {
    transform: rotate(-8deg);
  }

  /* Section headings: a label, a title and a line or two of introduction */
  .head {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    margin-bottom: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }
  .head__title {
    font-size: var(--step-4);
  }
  .head__intro {
    max-width: 36rem;
    color: var(--ink-soft);
    font-size: var(--step-1);
    line-height: 1.6;
  }
  .head--center {
    justify-items: center;
    text-align: center;
  }

  /* Photographs: soft shapes on a quiet placeholder */
  section :global(.figure) {
    --figure-radius: 1.5rem;
    --figure-placeholder-bg: var(--cream-200);
    --figure-placeholder-ink: var(--line-strong);
  }
  section :global(.figure img) {
    transition: transform 0.9s var(--ease);
  }

  /* A button with an arrow that moves a little on hover */
  .btn--go span {
    transition: transform 0.25s var(--ease);
  }
  .btn--go:hover span {
    transform: translateX(3px);
  }
  .btn--down:hover span {
    transform: translateY(3px);
  }
  .btn:active {
    transform: translateY(1px);
  }

  /* Why RootMap */
  .why__top {
    display: grid;
    gap: var(--space-8);
  }
  .why__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    max-width: 36rem;
    color: var(--ink-soft);
  }
  .why__title {
    max-width: 14ch;
    margin-bottom: var(--space-2);
    font-size: var(--step-4);
  }
  :lang(zh) .why__title {
    max-width: 12em;
  }
  .why__title + p {
    color: var(--ink);
    font-size: var(--step-1);
    line-height: 1.55;
  }
  .why__text .text-link {
    margin-top: var(--space-2);
  }
  /* A larger photograph with a small detail tucked over its corner */
  .why__collage {
    position: relative;
    padding-right: 5%;
  }
  section :global(.why__photo) {
    --figure-radius: 1.5rem 6rem 1.5rem 1.5rem;
  }
  :global(.why__photo figcaption) {
    max-width: 30rem;
    font-family: var(--font-serif);
    font-size: var(--step-0);
    font-style: italic;
    line-height: 1.5;
    color: var(--green-700);
  }
  :global(:lang(zh) .why__photo figcaption) {
    font-family: var(--font-serif-zh);
    font-style: normal;
  }
  section :global(.why__detail) {
    position: absolute;
    top: -2.25rem;
    right: 0;
    width: 32%;
    padding: 0.4rem;
    border-radius: 1.4rem;
    background: var(--paper);
    transform: rotate(4deg);
    transition: transform 0.5s var(--ease);
    --figure-radius: 1.1rem;
    --figure-placeholder-bg: var(--gold-100);
  }
  .why__collage:hover :global(.why__detail) {
    transform: rotate(1deg) translateY(-3px);
  }
  :global(.why__detail .figure__label) {
    left: 0.6rem;
    bottom: 0.5rem;
  }
  :global(.why__detail .figure__label code) {
    display: none;
  }

  /* Six ideas on one vine */
  .roots {
    position: relative;
    margin-top: clamp(3rem, 2rem + 4vw, 6rem);
    --bead: 4.5rem;
  }
  .roots__stem {
    position: absolute;
    top: -1rem;
    left: calc(var(--bead) / 2 - 12px);
    width: 24px;
    height: calc(100% + 2rem);
    color: var(--green-600);
  }
  .roots__stem path {
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .roots__list {
    position: relative;
    display: grid;
    gap: var(--space-6);
  }
  .idea {
    display: grid;
    grid-template-columns: var(--bead) 1fr;
    gap: var(--space-4);
    align-items: center;
  }
  .idea__art {
    display: grid;
    place-items: center;
    width: var(--bead);
    height: var(--bead);
    border-radius: 58% 42% 55% 45% / 48% 56% 44% 52%;
    background: var(--sage-100);
    transition: border-radius 0.6s var(--ease);
  }
  .idea:nth-child(3n + 2) .idea__art {
    border-radius: 45% 55% 42% 58% / 56% 44% 56% 44%;
    background: var(--gold-100);
  }
  .idea:nth-child(3n) .idea__art {
    border-radius: 52% 48% 60% 40% / 42% 58% 42% 58%;
    background: var(--cream-200);
  }
  .idea:hover .idea__art {
    border-radius: 50%;
  }
  .idea__art :global(.botanical) {
    width: 72%;
    transition: transform 0.5s var(--ease);
    transform-origin: 50% 90%;
  }
  .idea:hover .idea__art :global(.botanical) {
    transform: rotate(-9deg) scale(1.06);
  }
  .idea h4 {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    font-weight: 500;
  }
  :lang(zh) .idea h4 {
    font-family: var(--font-serif-zh);
    font-weight: 600;
  }
  .idea p {
    margin-top: var(--space-1);
    color: var(--ink-soft);
  }
  @media (min-width: 56em) {
    .why__top {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-5);
      align-items: center;
    }
    .why__text {
      grid-column: 1 / 7;
    }
    .why__collage {
      grid-column: 8 / -1;
      padding-right: 0;
    }
    section :global(.why__detail) {
      right: -1.5rem;
      width: 34%;
    }
    /* Wide screens: the vine runs down the middle, with ideas to the left and right, each a step below the last */
    .roots {
      --bead: 5rem;
      --step-down: 5.5rem;
      max-width: 62rem;
      margin-inline: auto;
      padding-bottom: var(--step-down);
    }
    .roots__stem {
      left: calc(50% - 12px);
    }
    .roots__list {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: minmax(calc(var(--step-down) * 2), auto);
      gap: 0;
    }
    .idea {
      gap: var(--space-5);
    }
    .idea:nth-child(odd) {
      grid-template-columns: 1fr var(--bead);
      margin-right: calc(var(--bead) / -2 + 0.9rem);
      text-align: right;
    }
    .idea:nth-child(odd) .idea__art {
      order: 1;
    }
    .idea:nth-child(odd) p {
      margin-left: auto;
    }
    .idea:nth-child(even) {
      position: relative;
      top: var(--step-down);
      margin-left: calc(var(--bead) / -2 + 0.9rem);
    }
    .idea p {
      max-width: 22rem;
    }
  }
</style>
