---
// An authentic RootMap app screenshot at phone proportions, or a labelled placeholder of the same shape.
import { url } from '../i18n';
import { SCREENSHOT_SIZE } from '../config/images';

interface Props {
  src: string;
  alt: string;
  placeholder: string;
  class?: string;
}
const { src, alt, placeholder, class: className } = Astro.props;
---

<div class:list={['shot', className]}>
  {
    src ? (
      <img src={url(src)} alt={alt} width={SCREENSHOT_SIZE.width} height={SCREENSHOT_SIZE.height} loading="lazy" decoding="async" />
    ) : (
      <div class="shot__placeholder" aria-hidden="true">
        <span>{placeholder}</span>
      </div>
    )
  }
</div>

<style>
  .shot {
    width: 100%;
    max-width: 17.5rem;
  }
  img,
  .shot__placeholder {
    width: 100%;
    aspect-ratio: 585 / 1266;
    border-radius: 2rem;
    border: 1px solid var(--line);
    box-shadow:
      0 1px 2px rgba(43, 37, 32, 0.05),
      0 24px 48px -24px rgba(35, 58, 46, 0.28);
    background: var(--cream-100);
  }
  .shot__placeholder {
    display: grid;
    place-items: center;
    padding: 1.5rem;
    text-align: center;
    color: var(--muted);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.04em;
    background: repeating-linear-gradient(-45deg, var(--cream-100) 0 14px, var(--white) 14px 28px);
  }
</style>
