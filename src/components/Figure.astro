---
// A photograph or illustration slot. With an image it renders a responsive, cropped <img>; without one it renders a
// quiet, clearly labelled placeholder of the same shape, so layouts look finished before final images arrive.
import { url } from '../i18n';
import type { ImageSlot } from '../config/images';

interface Props {
  image: ImageSlot;
  alt: string;
  placeholder: string;
  caption?: string;
  eager?: boolean;
  class?: string;
}
const { image: slot, alt, placeholder, caption, eager = false, class: className } = Astro.props;
const style = `aspect-ratio: ${slot.ratio};${slot.position ? ` object-position: ${slot.position};` : ''}`;
---

<figure class:list={['figure', className]}>
  {
    slot.src ? (
      <img
        src={url(slot.src)}
        alt={alt}
        style={style}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={eager ? 'high' : undefined}
      />
    ) : (
      <div class="figure__placeholder" style={`aspect-ratio: ${slot.ratio}`} aria-hidden="true">
        <svg class="figure__mark" viewBox="0 0 46 46" fill="none">
          <path d="M23 39V19M23 26l-8-7M23 23l8-9M23 30l11-7M17 39h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          <circle cx="13" cy="16" r="6" stroke="currentColor" stroke-width="1.4" />
          <circle cx="23" cy="11" r="7" stroke="currentColor" stroke-width="1.4" />
          <circle cx="33" cy="12" r="6" stroke="currentColor" stroke-width="1.4" />
          <circle cx="36" cy="23" r="5.5" stroke="currentColor" stroke-width="1.4" />
          <circle cx="15" cy="25" r="5" stroke="currentColor" stroke-width="1.4" />
        </svg>
        <span class="figure__label">
          {placeholder}
          <code>images/{slot.folder}/ · {slot.ratio.replace(/\s/g, '')}</code>
        </span>
      </div>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    position: relative;
  }
  img,
  .figure__placeholder {
    width: 100%;
    border-radius: var(--radius-lg);
    object-fit: cover;
  }
  .figure__placeholder {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 85% 10%, rgba(226, 184, 92, 0.16), transparent 60%),
      radial-gradient(100% 80% at 10% 100%, rgba(75, 124, 99, 0.14), transparent 60%),
      var(--sage-100);
    color: var(--sage-300);
  }
  .figure__mark {
    width: min(28%, 8rem);
    height: auto;
  }
  .figure__label {
    position: absolute;
    left: 1rem;
    bottom: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    color: var(--muted);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .figure__label code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 400;
    font-size: 0.72rem;
    letter-spacing: 0;
    opacity: 0.85;
  }
  figcaption {
    margin-top: var(--space-3);
    color: var(--muted);
    font-size: var(--step--1);
  }
</style>
