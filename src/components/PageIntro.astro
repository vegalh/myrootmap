---
// The opening of every page other than Home: eyebrow, title and lead, on a quiet cream band.
import SectionHeader from './SectionHeader.astro';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="page-intro">
  <div class="container">
    <SectionHeader level="h1" eyebrow={eyebrow} title={title} intro={lead}>
      <slot />
    </SectionHeader>
  </div>
</section>

<style>
  .page-intro {
    padding-block: clamp(3.5rem, 2rem + 6vw, 7rem) clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
    background: linear-gradient(to bottom, var(--cream-100), var(--paper));
  }
</style>
