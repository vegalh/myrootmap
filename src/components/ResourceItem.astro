---
import { formatDate, t, url, type Lang } from '../i18n';
import type { Resource } from '../lib/content';

interface Props {
  resource: Resource;
  lang: Lang;
}
const { resource, lang } = Astro.props;
const copy = t(lang);
const { title, description, type, href, source, date } = resource.data;
const external = /^https?:\/\//.test(href);
const link = external ? href : url(href);
const isFile = !external && /\.(pdf|docx?|pptx?|zip|png|jpe?g)$/i.test(href);
const otherLanguage = resource.data.lang !== lang;
---

<li class="resource">
  <div class="resource__meta">
    <span class="tag tag--gold">{copy.categories.resourceTypes[type]}</span>
    {otherLanguage && <span class="resource__lang">{t(resource.data.lang).meta.languageName}</span>}
  </div>
  <h3 class="resource__title" lang={otherLanguage ? t(resource.data.lang).meta.htmlLang : undefined}>
    <a href={link} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined} download={isFile ? '' : undefined}>
      {title}
      {external && <span class="visually-hidden"> ({copy.common.newWindow})</span>}
    </a>
  </h3>
  <p class="resource__desc">{description}</p>
  {(source || date) && <p class="resource__source">{[source, date && formatDate(date, lang)].filter(Boolean).join(' · ')}</p>}
  <span class="resource__action" aria-hidden="true">{isFile ? copy.resources.download : copy.resources.open} {isFile ? '↓' : external ? '↗' : '→'}</span>
</li>

<style>
  .resource {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    transition: border-color 0.2s var(--ease);
  }
  .resource:hover {
    border-color: var(--green-500);
  }
  .resource__meta {
    display: flex;
    gap: var(--space-3);
    align-items: center;
  }
  .resource__lang {
    color: var(--muted);
    font-size: var(--step--1);
  }
  .resource__title {
    font-size: var(--step-1);
  }
  .resource__title a {
    text-decoration: none;
  }
  .resource__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .resource__desc {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }
  .resource__source {
    color: var(--muted);
    font-size: var(--step--1);
  }
  .resource__action {
    margin-top: auto;
    padding-top: var(--space-2);
    color: var(--green-500);
    font-size: var(--step--1);
    font-weight: 700;
  }
</style>
