---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  id?: string;
  level?: 'h1' | 'h2';
  class?: string;
}
const { eyebrow, title, intro, id, level = 'h2', class: className } = Astro.props;
const Heading = level;
---

<div class:list={['section-header', className]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Heading id={id} class="section-header__title">{title}</Heading>
  {intro && <p class="lead">{intro}</p>}
  <slot />
</div>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    max-width: 44rem;
  }
  .section-header__title {
    font-size: var(--step-3);
  }
  h1.section-header__title {
    font-size: var(--step-5);
  }
  .lead {
    max-width: 38rem;
  }
</style>
