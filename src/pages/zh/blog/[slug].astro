---
import BlogPost from '../../../views/BlogPost.astro';
import { getPosts, postSlug } from '../../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts('zh');
  return posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}

const { post } = Astro.props;
---

<BlogPost post={post} />
