---
// The homepage: a hero, why RootMap exists (one plant growing through four stages), the app in everyday life,
// notes (blog and resources) and an invitation to help shape the community.
// The vines, leaves and flowers are RootMap's botanical illustrations: see src/illustrations/botanicals.ts.
import '@fontsource-variable/fraunces/wght-italic.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Botanical from '../components/Botanical.astro';
import Figure from '../components/Figure.astro';
import Screenshot from '../components/Screenshot.astro';
import { formatDate, localePath, t, type Lang } from '../i18n';
import { APP_URL } from '../config/site';
import { IMAGES, SCREENSHOTS } from '../config/images';
import { getPublishedPosts, postUrl } from '../lib/content';
import type { BotanicalName } from '../illustrations/botanicals';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
const home = copy.home;
const [featured, ...morePosts] = await getPublishedPosts(lang, 3);
const resourceCategories = Object.entries(copy.categories.resources) as [keyof typeof copy.categories.resources, { title: string; body: string }][];

// One plant, four stages: the drawing beside each idea in "Why RootMap".
const STAGE_ART: BotanicalName[] = ['stageSeed', 'stageSprout', 'stageBranch', 'stageBloom'];
const CATEGORY_ART: Record<keyof typeof copy.categories.resources, BotanicalName> = {
  development: 'catSeedling',
  everyday: 'catTwig',
  observation: 'catBud',
  activities: 'catBerries',
  reading: 'catFern',
  educators: 'catFlower',
};
---

<BaseLayout lang={lang} title={home.title} fullTitle>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="kicker"><Botanical name="sprig" />{home.hero.eyebrow}</p>
        <h1 class="hero__title" id="hero-title">
          {home.hero.titleLines.map((line) => <span class="hero__line">{line}</span>)}
        </h1>
        <p class="hero__lead">{home.hero.body}</p>
        <div class="hero__actions">
          <a class="btn btn--go" href={APP_URL}>{home.hero.primary}<span aria-hidden="true">→</span></a>
          <a class="text-link" href={localePath(lang, '/features')}>{home.hero.secondary}</a>
        </div>
      </div>
      <div class="hero__art">
        <span class="hero__patch" aria-hidden="true"></span>
        <Figure class="hero__media" image={IMAGES.homeHero} alt={home.hero.imageAlt} placeholder={copy.common.imagePlaceholder} eager />
        <Botanical name="heroVine" class="hero__vine" grow />
        <Botanical name="heroVineSmall" class="hero__vine-small" grow />
      </div>
    </div>
  </section>

  <!-- Why RootMap -->
  <section class="section why" id="why" aria-labelledby="why-title">
    <div class="container">
      <div class="why__top">
        <div class="why__text">
          <p class="kicker"><Botanical name="sprig" />{home.why.eyebrow}</p>
          <h2 class="why__title" id="why-title">{home.why.title}</h2>
          {home.why.intro.map((p) => <p>{p}</p>)}
          <a class="text-link" href={localePath(lang, '/philosophy')}>{home.why.link}</a>
        </div>
        <Figure class="why__photo" image={IMAGES.homeChildhoodMain} alt={home.why.imageAlt} caption={home.why.caption} placeholder={copy.common.imagePlaceholder} />
      </div>

      <h3 class="visually-hidden">{home.why.stagesLabel}</h3>
      <div class="growth">
        <!-- The runner the four plants grow from: it lies along the ground on wide screens and climbs on phones -->
        <svg class="growth__runner growth__runner--across" viewBox="0 0 1200 28" preserveAspectRatio="none" fill="none" aria-hidden="true">
          <path d="M0 17C140 3 290 27 450 14S760 5 900 17S1110 25 1200 11"></path>
        </svg>
        <svg class="growth__runner growth__runner--down" viewBox="0 0 24 800" preserveAspectRatio="none" fill="none" aria-hidden="true">
          <path d="M12 0C3 90 21 180 12 270S4 450 13 540S20 720 11 800"></path>
        </svg>
        <ol class="growth__stages" role="list">
          {
            home.why.stages.map((stage, i) => (
              <li class="growth__stage">
                <Botanical name={STAGE_ART[i]} class="growth__plant js-grow" />
                <div>
                  <h4>{stage.title}</h4>
                  <p>{stage.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- RootMap in everyday life -->
  <section class="section section--forest product" id="everyday-life" aria-labelledby="product-title">
    <svg class="wave wave--top" viewBox="0 0 1440 48" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 48V24C190 2 380 42 640 27S1130 0 1440 21V48Z" fill="currentColor"></path>
    </svg>
    <Botanical name="edgeVine" class="product__vine" />
    <div class="container product__inner">
      <div class="product__head">
        <p class="kicker"><Botanical name="sprig" />{home.product.chapter}</p>
        <h2 class="product__title" id="product-title">{home.product.title}</h2>
        <p class="product__intro">{home.product.intro}</p>
      </div>
      <div class="product__show">
        <div class="product__stage">
          <Screenshot src={SCREENSHOTS[home.product.featured.id]} alt={home.product.featured.shotAlt} placeholder={copy.common.screenshotPlaceholder} />
        </div>
        <div class="product__featured">
          <p class="product__kicker">{home.product.featured.kicker}</p>
          <h3>{home.product.featured.title}</h3>
          <p class="product__lead">{home.product.featured.lead}</p>
          <p>{home.product.featured.body}</p>
        </div>
        <ul class="product__more" role="list">
          {
            home.product.supporting.map((item) => (
              <li>
                <Screenshot src={SCREENSHOTS[item.id]} alt={item.shotAlt} placeholder={copy.common.screenshotPlaceholder} />
                <div>
                  <p class="product__kicker">{item.kicker}</p>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="product__foot">
        <a class="btn btn--light btn--go" href={APP_URL}>{home.product.app}<span aria-hidden="true">→</span></a>
        <a class="text-link" href={localePath(lang, '/features')}>{home.product.link}</a>
        <p class="product__note">{home.product.demoNote}</p>
      </div>
    </div>
    <svg class="wave wave--bottom" viewBox="0 0 1440 48" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 48V24C190 2 380 42 640 27S1130 0 1440 21V48Z" fill="currentColor"></path>
    </svg>
  </section>

  <!-- Notes on growing: blog and resources -->
  <section class="section section--cream notes" id="notes" aria-labelledby="notes-title">
    <div class="container">
      <div class="notes__head">
        <p class="kicker"><Botanical name="sprig" />{home.notes.chapter}</p>
        <h2 class="notes__title" id="notes-title">{home.notes.title}</h2>
        <p class="notes__intro">{home.notes.intro}</p>
      </div>

      {
        featured ? (
          <div class="notes__blog">
            <article class="feature">
              <a href={postUrl(featured)} class="feature__media" tabindex="-1" aria-hidden="true">
                <Figure image={{ src: featured.data.cover ?? '', ratio: '4 / 3', folder: 'blog' }} alt={featured.data.coverAlt} placeholder={copy.common.imagePlaceholder} />
              </a>
              <div class="feature__body">
                <p class="feature__meta">
                  <span class="tag">{copy.categories.blog[featured.data.category]}</span>
                  {featured.data.date && <time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date, lang)}</time>}
                </p>
                <h3 class="feature__title">
                  <a href={postUrl(featured)}>{featured.data.title}</a>
                </h3>
                <p class="feature__desc">{featured.data.description}</p>
                <a class="text-link" href={postUrl(featured)} aria-label={`${copy.common.readArticle}: ${featured.data.title}`}>
                  {copy.common.readArticle}
                </a>
              </div>
            </article>
            {morePosts.length > 0 && (
              <ul class="stories" role="list">
                {morePosts.map((post) => (
                  <li class="story">
                    <a href={postUrl(post)} class="story__media" tabindex="-1" aria-hidden="true">
                      <Figure image={{ src: post.data.cover ?? '', ratio: '1 / 1', folder: 'blog' }} alt={post.data.coverAlt} placeholder={copy.common.imagePlaceholder} />
                    </a>
                    <div>
                      <p class="feature__meta">
                        <span class="tag">{copy.categories.blog[post.data.category]}</span>
                        {post.data.date && <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>}
                      </p>
                      <h3 class="story__title">
                        <a href={postUrl(post)}>{post.data.title}</a>
                      </h3>
                    </div>
                  </li>
                ))}
              </ul>
            )}
            <a class="text-link" href={localePath(lang, '/blog')}>{home.notes.blogLink}</a>
          </div>
        ) : (
          <div class="feature feature--empty">
            <span class="feature__pot" aria-hidden="true">
              <Botanical name="catSeedling" class="js-grow" />
            </span>
            <div class="feature__body">
              <p class="tag tag--draft">{home.notes.placeholderTag}</p>
              <p class="feature__desc">{home.notes.empty}</p>
              <a class="text-link" href={localePath(lang, '/blog')}>{home.notes.blogLink}</a>
            </div>
          </div>
        )
      }

      <div class="library">
        <div class="library__intro">
          <h3 class="library__title">{home.notes.resourcesTitle}</h3>
          <p>{home.notes.resourcesIntro}</p>
          <p class="library__note">{home.notes.resourcesNote}</p>
          <a class="text-link" href={localePath(lang, '/resources')}>{home.notes.resourcesLink}</a>
        </div>
        <ul class="library__list" role="list">
          {
            resourceCategories.map(([key, cat]) => (
              <li>
                <a class="seed" href={`${localePath(lang, '/resources')}#${key}`}>
                  <span class="seed__art">
                    <Botanical name={CATEGORY_ART[key]} />
                  </span>
                  <span>
                    <span class="seed__name">{cat.title}</span>
                    <span class="seed__body">{cat.body}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Grow with us: the community invitation -->
  <section class="section section--sage invite" id="grow-with-us" aria-labelledby="invite-title">
    <div class="container invite__grid">
      <div class="invite__letter">
        <p class="kicker"><Botanical name="sprig" />{home.community.chapter}</p>
        <h2 class="invite__title" id="invite-title">{home.community.title}</h2>
        <p class="tag tag--gold">{home.community.status}</p>
        {home.community.paragraphs.map((p) => <p class="invite__body">{p}</p>)}
        <div class="invite__cta">
          <a class="btn btn--go" href={localePath(lang, '/community')}>{home.community.cta}<span aria-hidden="true">→</span></a>
          <p>{home.community.ctaNote}</p>
        </div>
      </div>
      <div class="invite__art">
        <Figure class="invite__media" image={IMAGES.homeCommunity} alt={home.community.imageAlt} placeholder={copy.common.imagePlaceholder} />
        <Botanical name="together" class="invite__vines js-grow" />
      </div>
      <div class="invite__ps">
        <span class="invite__ps-art" aria-hidden="true"><Botanical name="catSeedling" /></span>
        <p><span class="invite__ps-label">{home.community.ps.label}</span> {home.community.ps.body}</p>
        <a class="btn btn--secondary" href={APP_URL}>{home.community.ps.button}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Drawings below the first screen grow when they scroll into view. Without this script they are simply there.
  const drawings = document.querySelectorAll('.js-grow');
  if (drawings.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('botanical--grow');
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.35 },
    );
    drawings.forEach((drawing) => observer.observe(drawing));
  }
</script>

<style>
  /* Shared pieces */
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--green-600);
    font-size: var(--step--1);
    font-weight: 700;
  }
  .kicker :global(.botanical) {
    width: 1.75rem;
    flex-shrink: 0;
    transition: transform 0.5s var(--ease);
    transform-origin: 10% 90%;
  }
  section:hover .kicker :global(.botanical) {
    transform: rotate(-8deg);
  }

  /* Photographs: soft shapes on a quiet placeholder */
  section :global(.figure) {
    --figure-radius: 1.5rem;
    --figure-placeholder-bg: var(--cream-200);
    --figure-placeholder-ink: var(--line-strong);
  }
  section :global(.figure img) {
    transition: transform 0.9s var(--ease);
  }

  /* A button with an arrow that moves a little on hover */
  .btn--go span {
    transition: transform 0.25s var(--ease);
  }
  .btn--go:hover span {
    transform: translateX(3px);
  }
  .btn:active {
    transform: translateY(1px);
  }

  /* Hero */
  .hero {
    padding-block: clamp(2rem, 1rem + 4vw, 4.5rem) clamp(3rem, 2rem + 4vw, 6rem);
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    gap: var(--space-7);
  }
  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }
  .hero__title {
    display: flex;
    flex-direction: column;
    font-size: clamp(2.7rem, 1.4rem + 5.2vw, 5.4rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-wrap: initial;
  }
  .hero__line:last-child {
    padding-left: 0.5em;
    font-style: italic;
    font-weight: 400;
    color: var(--terracotta-700);
  }
  :lang(zh) .hero__title {
    font-size: clamp(2.4rem, 1.2rem + 4.4vw, 4.6rem);
    line-height: 1.25;
    letter-spacing: 0.02em;
  }
  :lang(zh) .hero__line:last-child {
    font-style: normal;
  }
  .hero__lead {
    max-width: 31rem;
    color: var(--ink-soft);
    font-size: var(--step-1);
    line-height: 1.6;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    width: 100%;
  }
  .hero__art {
    position: relative;
    z-index: 0;
    padding-left: 22%;
  }
  /* A soft patch of sage behind the photograph */
  .hero__patch {
    position: absolute;
    z-index: -1;
    inset: 12% -12% -5% 6%;
    border-radius: 58% 42% 55% 45% / 48% 56% 44% 52%;
    background: var(--sage-100);
  }
  section :global(.hero__media) {
    --figure-radius: 999px 999px 1.5rem 1.5rem;
  }
  :global(.hero__vine) {
    display: none;
  }
  :global(.hero__vine-small) {
    position: absolute;
    left: 3%;
    bottom: -3%;
    width: 24%;
  }
  @media (max-width: 35.99em) {
    .hero__actions .btn {
      flex-basis: 100%;
      min-height: 3.25rem;
    }
  }
  @media (min-width: 56em) {
    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-5);
      align-items: center;
    }
    .hero__text {
      grid-column: 1 / 8;
      gap: var(--space-6);
    }
    .hero__title {
      font-size: clamp(2.9rem, 0.5rem + 4.3vw, 4.4rem);
    }
    .hero__line {
      white-space: nowrap;
    }
    .hero__art {
      grid-column: 8 / -1;
      padding-left: 16%;
    }
    .hero__patch {
      inset: 14% -22% -6% -4%;
    }
    :global(.hero__vine) {
      display: block;
      position: absolute;
      left: -6%;
      bottom: -5%;
      width: 46%;
    }
    :global(.hero__vine-small) {
      display: none;
    }
  }

  /* Why RootMap */
  .why__top {
    display: grid;
    gap: var(--space-7);
  }
  .why__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    max-width: 36rem;
    color: var(--ink-soft);
  }
  .why__title {
    max-width: 14ch;
    margin-bottom: var(--space-2);
    font-size: var(--step-4);
  }
  :lang(zh) .why__title {
    max-width: 12em;
  }
  .why__title + p {
    color: var(--ink);
    font-size: var(--step-1);
    line-height: 1.55;
  }
  .why__text .text-link {
    margin-top: var(--space-2);
  }
  section :global(.why__photo) {
    --figure-radius: 1.5rem 6rem 1.5rem 1.5rem;
  }
  :global(.why__photo figcaption) {
    max-width: 30rem;
    font-family: var(--font-serif);
    font-size: var(--step-0);
    font-style: italic;
    line-height: 1.5;
    color: var(--green-700);
  }
  :global(:lang(zh) .why__photo figcaption) {
    font-family: var(--font-serif-zh);
    font-style: normal;
  }

  .growth {
    position: relative;
    margin-top: clamp(3rem, 2rem + 4vw, 6rem);
    --plant-w: 5rem;
  }
  .growth__runner {
    position: absolute;
    color: var(--green-600);
  }
  .growth__runner path {
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  /* Phones: the runner climbs the left edge and each stage grows beside it */
  .growth__runner--across {
    display: none;
  }
  .growth__runner--down {
    top: 0;
    left: calc(var(--plant-w) / 2 - 12px);
    width: 24px;
    height: 100%;
  }
  .growth__stages {
    position: relative;
    display: grid;
    gap: var(--space-6);
  }
  .growth__stage {
    display: grid;
    grid-template-columns: var(--plant-w) 1fr;
    gap: var(--space-4);
    align-items: end;
  }
  :global(.growth__plant) {
    width: var(--plant-w);
    transition: transform 0.6s var(--ease);
    transform-origin: 50% 100%;
  }
  .growth__stage:hover :global(.growth__plant) {
    transform: rotate(-4deg);
  }
  .growth__stage h4 {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    font-weight: 500;
  }
  :lang(zh) .growth__stage h4 {
    font-family: var(--font-serif-zh);
    font-weight: 600;
  }
  .growth__stage p {
    margin-top: var(--space-1);
    color: var(--ink-soft);
  }
  @media (min-width: 56em) {
    .why__top {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-5);
      align-items: center;
    }
    .why__text {
      grid-column: 1 / 7;
    }
    :global(.why__photo) {
      grid-column: 8 / -1;
    }
    /* Wide screens: the runner lies along the ground and the four plants stand on it, each taller than the last */
    .growth {
      --plant-w: 7.75rem;
      --plant-h: calc(var(--plant-w) * 170 / 120);
    }
    .growth__runner--across {
      display: block;
      top: calc(var(--plant-h) - 16px);
      left: calc(-1 * var(--gutter));
      width: calc(100% + 2 * var(--gutter));
      height: 28px;
    }
    .growth__runner--down {
      display: none;
    }
    .growth__stages {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-6);
    }
    .growth__stage {
      display: block;
    }
    .growth__stage > div {
      margin-top: var(--space-6);
      max-width: 17rem;
    }
  }

  /* RootMap in everyday life */
  .product {
    position: relative;
  }
  .wave {
    position: absolute;
    left: 0;
    z-index: 1;
    width: 100%;
    height: clamp(18px, 3.4vw, 48px);
    color: var(--green-800);
    pointer-events: none;
  }
  .wave--top {
    top: 1px;
    transform: translateY(-100%);
  }
  .wave--bottom {
    bottom: 1px;
    transform: translateY(100%) rotate(180deg);
  }
  .product__inner {
    position: relative;
  }
  :global(.product__vine) {
    position: absolute;
    top: 0;
    right: 0;
    width: clamp(4.5rem, 11vw, 10rem);
    --bot-stem: rgba(201, 214, 198, 0.34);
    --bot-leaf-a: rgba(201, 214, 198, 0.2);
    --bot-leaf-b: rgba(201, 214, 198, 0.12);
    --bot-leaf-c: rgba(75, 124, 99, 0.6);
    --bot-terra: rgba(217, 139, 98, 0.65);
  }
  .product .kicker {
    color: var(--gold-400);
    --bot-stem: var(--sage-300);
    --bot-leaf-a: var(--sage-300);
    --bot-leaf-b: var(--green-500);
  }
  .product__head {
    display: grid;
    gap: var(--space-5);
    margin-bottom: clamp(2.5rem, 1.5rem + 4vw, 5rem);
  }
  .product__title {
    max-width: 18ch;
    font-size: var(--step-4);
  }
  :lang(zh) .product__title {
    max-width: 14em;
  }
  .product__intro {
    max-width: 32rem;
    color: rgba(250, 238, 220, 0.86);
    font-size: var(--step-1);
  }
  .product__show {
    display: grid;
    gap: var(--space-7);
  }
  .product__stage {
    display: grid;
    place-items: center;
    padding-block: var(--space-7);
    margin-inline: calc(-1 * var(--gutter));
    background: var(--green-700);
  }
  .product__stage :global(.shot) {
    width: 70%;
    max-width: 22rem;
  }
  .product :global(.shot img) {
    border-color: rgba(248, 241, 230, 0.22);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.6);
  }
  .product__kicker {
    color: var(--gold-400);
    font-size: var(--step--1);
    font-weight: 700;
  }
  .product h3 {
    margin-block: var(--space-2) var(--space-3);
    font-family: var(--font-serif);
    font-weight: 500;
    color: var(--white);
  }
  :lang(zh) .product h3 {
    font-family: var(--font-serif-zh);
    font-weight: 600;
  }
  .product__featured h3 {
    font-size: var(--step-4);
  }
