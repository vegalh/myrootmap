---
// Homepage layouts and shared copy for English and Chinese.
// Image slots live in src/config/images.ts, inspiration entries in src/config/inspirations.ts.
import '@fontsource-variable/fraunces/wght-italic.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Botanical from '../components/Botanical.astro';
import Figure from '../components/Figure.astro';
import Screenshot from '../components/Screenshot.astro';
import ValuesRibbon from '../components/ValuesRibbon.astro';
import { localePath, t, url, type Lang } from '../i18n';
import { APP_URL, APP_LOGIN_URL, CONTACT_EMAIL, FEEDBACK_URL, SHOW_DESIGN_PLACEHOLDERS, SURVEY_URLS, WECHAT_ID, XIAOHONGSHU_URL } from '../config/site';
import { IMAGES, SCREENSHOTS } from '../config/images';
import { INSPIRATIONS, localized, type InspirationKind } from '../config/inspirations';
import { getPublishedPosts, postUrl } from '../lib/content';
import type { BotanicalName } from '../illustrations/botanicals';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
const home = copy.home;
const explore = home.explore;
const [latestPost] = await getPublishedPosts(lang, 1);
const otherLang = lang === 'zh' ? 'en' : 'zh-CN';

// The drawing beside each idea in "Why RootMap", in the order the ideas are written.
const IDEA_ART: BotanicalName[] = ['catTwig', 'catBerries', 'catBud', 'catSeedling', 'catFern', 'catFlower'];

// Inspired by: people are shown as round portraits, books and papers as upright covers, approaches as a leaf shape.
const KIND_SHAPE: Record<InspirationKind, 'portrait' | 'cover' | 'idea' | 'logo'> = {
  educator: 'portrait',
  researcher: 'portrait',
  author: 'portrait',
  creator: 'portrait',
  book: 'cover',
  paper: 'cover',
  philosophy: 'idea',
  logo: 'logo',
};
const KIND_ART: Record<InspirationKind, BotanicalName> = {
  educator: 'catFlower',
  researcher: 'catFern',
  author: 'catTwig',
  creator: 'catBerries',
  book: 'catBud',
  paper: 'catFern',
  philosophy: 'catSeedling',
  logo: 'catSeedling',
};
const inspirations = INSPIRATIONS.map((item) => ({
  kind: item.kind,
  name: localized(item.name, lang),
  by: localized(item.by, lang),
  note: localized(item.note, lang),
  quote: localized(item.quote, lang),
  image: item.image ?? '',
  imageAlt: localized(item.imageAlt, lang),
  href: item.href ?? '',
  placeholder: false,
}));
// With no entries yet: sample slots that show the layout while developing, and a short note on the published site.
const PLACEHOLDER_KINDS: InspirationKind[] = ['logo', 'logo', 'logo', 'educator', 'book', 'philosophy'];
const showPlaceholders = inspirations.length === 0 && SHOW_DESIGN_PLACEHOLDERS;
const shelf = showPlaceholders
  ? PLACEHOLDER_KINDS.map((kind) => ({ kind, name: kind === 'logo' ? (lang === 'zh' ? '标志待添加' : 'Your inspiration logo') : home.inspired.placeholder.name, by: '', note: home.inspired.placeholder.note, quote: '', image: '', imageAlt: '', href: '', placeholder: true }))
  : inspirations;

// The two community surveys. An empty link (src/config/site.ts) shows "Coming soon" instead of a button.
const surveys = [
  { key: 'china', lang: 'zh-CN', url: SURVEY_URLS.china, ...copy.community.survey.china },
  { key: 'international', lang: 'en', url: SURVEY_URLS.international, ...copy.community.survey.international },
];
const feedbackIsWeb = FEEDBACK_URL.startsWith('http');
---

<BaseLayout lang={lang} title={home.title} fullTitle>
  <!-- Hero: words on one side, a layered picture on the other (the photograph, with the app tucked over its corner) -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="kicker"><Botanical name="sprig" />{home.hero.eyebrow}</p>
        <h1 class="hero__title" id="hero-title">
          {
            home.hero.titleLines.map((line) => (
              <>
                <span class="hero__line">{line}</span>{lang === 'zh' ? '' : ' '}
              </>
            ))
          }
        </h1>
        <p class="hero__lead">{home.hero.body}</p>
        <div class="hero__actions">
          <a class="btn btn--go" href={APP_LOGIN_URL}>{copy.nav.login}<span aria-hidden="true">→</span></a>
          <a class="btn btn--secondary" href="#experience">{home.hero.primary}<span aria-hidden="true">↓</span></a>
          <a class="text-link" href="#founder">{home.hero.secondary}</a>
        </div>
        <p class="hero__note">
          <span class="hero__note-art" aria-hidden="true"><Botanical name="catSeedling" /></span>
          <span>{home.hero.note}</span>
        </p>
      </div>
      <div class="hero__art">
        <span class="hero__patch" aria-hidden="true"></span>
        <span class="hero__sun" aria-hidden="true"></span>
        <Figure class="hero__media" image={IMAGES.homeHero} alt={home.hero.imageAlt} placeholder={copy.common.imagePlaceholder} eager />
        <div class="hero__shot">
          <Screenshot src={SCREENSHOTS.today} alt={home.hero.shotAlt} placeholder={copy.common.screenshotPlaceholder} />
        </div>
        <Botanical name="heroVine" class="hero__vine" grow />
      </div>
    </div>
  </section>

  <!-- A length of vine between the hero and the rest: decoration only, it does not move -->
  <div class="container" aria-hidden="true">
    <div class="vine-rule">
      <svg class="vine-rule__line" viewBox="0 0 1200 28" preserveAspectRatio="none" fill="none">
        <path d="M0 17C140 3 290 27 450 14S760 5 900 17S1110 25 1200 11"></path>
      </svg>
      <Botanical name="sprig" />
      <Botanical name="sprig" />
      <Botanical name="sprig" />
    </div>
  </div>

  <!-- Why RootMap -->
  <section class="section why" id="why" aria-labelledby="why-title">
    <div class="container">
      <div class="why__top">
        <div class="why__text">
          <p class="kicker"><Botanical name="sprig" />{home.why.eyebrow}</p>
          <h2 class="why__title" id="why-title">{home.why.title}</h2>
          {home.why.intro.map((p) => <p>{p}</p>)}
          <a class="text-link" href={localePath(lang, '/philosophy')}>{home.why.link}</a>
        </div>
        <div class="why__collage">
          <Figure class="why__photo" image={IMAGES.homeChildhoodMain} alt={home.why.imageAlt} caption={home.why.caption} placeholder={copy.common.imagePlaceholder} />
          <Figure class="why__detail" image={IMAGES.homeChildhoodDetail} alt={home.why.detailAlt} placeholder={copy.common.imagePlaceholder} />
        </div>
      </div>

      <h3 class="visually-hidden">{home.why.ideasLabel}</h3>
      <div class="roots">
        <!-- The vine the six ideas grow on: down the middle on wide screens, along the left edge on phones -->
        <svg class="roots__stem" viewBox="0 0 24 800" preserveAspectRatio="none" fill="none" aria-hidden="true">
          <path d="M12 0C5 90 19 180 12 270S6 450 13 540S18 720 11 800"></path>
        </svg>
        <ul class="roots__list" role="list">
          {
            home.why.ideas.map((idea, i) => (
              <li class="idea">
                <span class="idea__art" aria-hidden="true">
                  <Botanical name={IDEA_ART[i]} class="js-grow" />
                </span>
                <div class="idea__text">
                  <h4>{idea.title}</h4>
                  <p>{idea.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Experience RootMap: the app as a journey -->
  <section class="section section--forest product" id="experience" aria-labelledby="product-title">
    <svg class="wave wave--top" viewBox="0 0 1440 48" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 48V24C190 2 380 42 640 27S1130 0 1440 21V48Z" fill="currentColor"></path>
    </svg>
    <Botanical name="edgeVine" class="product__vine" />
    <div class="container product__inner">
      <div class="product__head">
        <p class="kicker"><Botanical name="sprig" />{home.experience.chapter}</p>
        <h2 class="product__title" id="product-title">{home.experience.title}</h2>
        <p class="product__intro">{home.experience.intro}</p>
      </div>

      <!-- Four screens, each leading to the next: side by side on wide screens. On phones they are a carousel, one screen
           at a time with its words underneath and a dot for each step (the script at the foot of this file keeps them in step). -->
      <div class="stage">
      <ol class="journey" role="list" aria-label={home.experience.journeyLabel} tabindex="0">
        {
          home.experience.steps.map((step, i) => (
            <li class="step" data-active={i === 0 ? '' : undefined}>
              <div class="step__shot">
                <Screenshot src={SCREENSHOTS[step.id]} alt={step.shotAlt} placeholder={copy.common.screenshotPlaceholder} />
                {i < home.experience.steps.length - 1 && (
                  <button class="step__arrow" type="button" aria-label={home.experience.steps[i + 1].title}>
                    <span aria-hidden="true">→</span>
                  </button>
                )}
              </div>
              <div class="step__text">
                <p class="product__kicker">{step.kicker}</p>
                <h3>{step.title}</h3>
                <p class="product__lead">{step.lead}</p>
                <p>{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="captions" aria-live="polite">
        {
          home.experience.steps.map((step, i) => (
            <div class="step__text caption" data-active={i === 0 ? '' : undefined}>
              <p class="product__kicker">{step.kicker}</p>
              <h3>{step.title}</h3>
              <p class="product__lead">{step.lead}</p>
              <p>{step.body}</p>
            </div>
          ))
        }
      </div>
      <div class="dots" role="group" aria-label={home.experience.dotsLabel}>
        {
          home.experience.steps.map((step, i) => (
            <button type="button" aria-current={i === 0 ? 'true' : undefined}>
              <span class="visually-hidden">{step.title}</span>
            </button>
          ))
        }
      </div>
      </div>

      <div class="product__foot">
        <a class="btn btn--light btn--go" href={APP_URL}>{home.experience.app}<span aria-hidden="true">→</span></a>
        <a class="text-link" href={localePath(lang, '/features')}>{home.experience.link}</a>
        <p class="product__note">{home.experience.demoNote}</p>
      </div>
    </div>
    <svg class="wave wave--bottom" viewBox="0 0 1440 48" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 48V24C190 2 380 42 640 27S1130 0 1440 21V48Z" fill="currentColor"></path>
    </svg>
  </section>

  <!-- A little note from the founder. The arrow leads down into it from the app above. -->
  <section class="section section--cream founder" id="founder" aria-labelledby="founder-title">
    <svg class="founder__lead-in" viewBox="0 0 64 120" fill="none" aria-hidden="true">
      <path d="M32 4C22 34 42 62 32 104" />
      <path d="M15 84L32 110L49 84" />
      <path class="founder__lead-leaf" d="M27 40C17 38 11 31 10 22C19 23 26 30 27 40Z" />
      <path class="founder__lead-leaf" d="M36 60C46 59 53 53 55 44C46 44 38 50 36 60Z" />
    </svg>
    <div class="container">
      <div class="founder__note">
        <Botanical name="catTwig" class="founder__sprig js-grow" />
        <div class="founder__head">
          <p class="kicker"><Botanical name="sprig" />{home.founder.chapter}</p>
          <h2 class="founder__title" id="founder-title">{home.founder.title}</h2>
          {home.founder.draft && <p class="tag tag--draft">{home.founder.draftLabel}</p>}
        </div>
        <div class="founder__constellation" role="group" aria-label={home.founder.observationsTitle}>
          <div class="founder__art">
            <span class="founder__patch" aria-hidden="true"></span>
            <Figure class="founder__photo" image={IMAGES.founderPortrait} alt={home.founder.imageAlt} placeholder={copy.common.imagePlaceholder} />
            <Botanical name="heroVineSmall" class="founder__vine js-grow" />
          </div>
          <ul class="founder__thoughts" role="list">
            {home.founder.observations.map((thought) => <li>{thought}</li>)}
          </ul>
        </div>
        <div class="founder__words">
          {home.founder.intro.map((paragraph) => <p class="founder__body">{paragraph}</p>)}
          {home.founder.name && <p class="founder__sign">{home.founder.name}</p>}
        </div>
        <div class="founder__shaped">
          <h3>{home.founder.shaped.title}</h3>
          <p>{home.founder.shaped.experience}</p>
          <p>{home.founder.shaped.influences}</p>
          <a class="btn btn--secondary btn--small" href={`${localePath(lang, '/resources')}#bookshelf`}>{home.founder.shaped.bookshelf}<span aria-hidden="true">↗</span></a>
        </div>
        <div class="founder__actions">
          <a class="btn btn--go" href={localePath(lang, '/contact')}>{home.founder.connect}<span aria-hidden="true">→</span></a>
          <ul class="founder__channels" role="list" aria-label={home.founder.channels.label}>
            <li>
              {
                WECHAT_ID ? (
                  <span class="channel">
                    {home.founder.channels.wechat}: <strong>{WECHAT_ID}</strong>
                  </span>
                ) : (
                  <span class="channel channel--soon">
                    {home.founder.channels.wechat} · {home.founder.channels.soon}
                  </span>
                )
              }
            </li>
            <li>
              {
                XIAOHONGSHU_URL ? (
                  <a class="channel" href={XIAOHONGSHU_URL} target="_blank" rel="noopener">
                    {home.founder.channels.xiaohongshu}
                    <span aria-hidden="true">↗</span>
                    <span class="visually-hidden"> ({copy.common.newWindow})</span>
                  </a>
                ) : (
                  <span class="channel channel--soon">
                    {home.founder.channels.xiaohongshu} · {home.founder.channels.soon}
                  </span>
                )
              }
            </li>
            <li>
              {
                CONTACT_EMAIL ? (
                  <a class="channel" href={`mailto:${CONTACT_EMAIL}`}>
                    {home.founder.channels.email}: <strong>{CONTACT_EMAIL}</strong>
                  </a>
                ) : (
                  <span class="channel channel--soon">
                    {home.founder.channels.email} · {home.founder.channels.soon}
                  </span>
                )
              }
            </li>
          </ul>
          <a class="text-link" href={localePath(lang, '/about')}>{home.founder.about}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Explore more with us: three places to go next -->
  <section class="section explore" id="explore" aria-labelledby="explore-title">
    <div class="container">
      <div class="head">
        <p class="kicker"><Botanical name="sprig" />{explore.chapter}</p>
        <h2 class="head__title" id="explore-title">{explore.title}</h2>
        <p class="head__intro">{explore.intro}</p>
      </div>

      <div class="explore__mosaic">
        <!-- Blog: longer writing -->
        <article class="dest dest--blog">
          <div class="dest__body">
            <h3 class="dest__name">{explore.blog.name}</h3>
            <p class="dest__tagline">{explore.blog.tagline}</p>
            <ul class="dest__topics dest__topics--lines" role="list">
              {explore.blog.topics.map((topic) => <li>{topic}</li>)}
            </ul>
            {
              latestPost && (
                <p class="dest__latest">
                  <span>{explore.blog.latest}</span>
                  <a href={postUrl(latestPost)}>{latestPost.data.title}</a>
                </p>
              )
            }
            <a class="dest__cta" href={localePath(lang, '/blog')}>{explore.blog.cta}<span aria-hidden="true">→</span></a>
          </div>
          <div class="dest__media">
            <span class="dest__sheet" aria-hidden="true"></span>
            <Figure image={IMAGES.exploreBlog} alt={explore.blog.imageAlt} placeholder={copy.common.imagePlaceholder} />
          </div>
        </article>

        <!-- Resources: materials to use -->
        <article class="dest dest--resources">
          <div class="dest__media">
            <Figure image={IMAGES.exploreResources} alt={explore.resources.imageAlt} placeholder={copy.common.imagePlaceholder} />
            <span class="dest__specimen dest__specimen--a" aria-hidden="true"><Botanical name="catFern" /></span>
            <span class="dest__specimen dest__specimen--b" aria-hidden="true"><Botanical name="catBerries" /></span>
            <span class="dest__specimen dest__specimen--c" aria-hidden="true"><Botanical name="catFlower" /></span>
          </div>
          <div class="dest__body">
            <h3 class="dest__name">{explore.resources.name}</h3>
            <p class="dest__tagline">{explore.resources.tagline}</p>
            <ul class="dest__topics dest__topics--tags" role="list">
              {explore.resources.topics.map((topic) => <li>{topic}</li>)}
            </ul>
            <a class="dest__cta" href={localePath(lang, '/resources')}>{explore.resources.cta}<span aria-hidden="true">→</span></a>
          </div>
        </article>

        <!-- Xiaohongshu: photographs and small notes -->
        <article class="dest dest--xhs">
          <div class="dest__media">
            <span class="dest__snap dest__snap--back" aria-hidden="true"></span>
            <div class="dest__snap">
              <Figure image={IMAGES.exploreXiaohongshu} alt={explore.xiaohongshu.imageAlt} placeholder={copy.common.imagePlaceholder} />
            </div>
          </div>
          <div class="dest__body">
            <h3 class="dest__name">
              {explore.xiaohongshu.name}
              <span class="dest__native" lang={otherLang}>{explore.xiaohongshu.nativeName}</span>
            </h3>
            <p class="dest__tagline">{explore.xiaohongshu.tagline}</p>
            <ul class="dest__topics dest__topics--dots" role="list">
              {explore.xiaohongshu.topics.map((topic) => <li>{topic}</li>)}
            </ul>
            {
              XIAOHONGSHU_URL ? (
                <a class="dest__cta" href={XIAOHONGSHU_URL} target="_blank" rel="noopener">
                  {explore.xiaohongshu.cta}
                  <span aria-hidden="true">→</span>
                  <span class="visually-hidden"> ({copy.common.newWindow})</span>
                </a>
              ) : (
                <p class="dest__cta dest__cta--missing">
                  <span class="visually-hidden">{explore.xiaohongshu.cta}: </span>
                  {explore.linkMissing}
                </p>
              )
            }
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Inspired by: a small collection, hung along a vine -->
  <section class="section section--cream inspired" id="inspired-by" aria-labelledby="inspired-title">
    <div class="container inspired__grid">
      <div class="head inspired__head">
        <p class="kicker"><Botanical name="sprig" />{home.inspired.chapter}</p>
        <h2 class="head__title" id="inspired-title">{home.inspired.title}</h2>
        <p class="head__intro">{home.inspired.intro}</p>
      </div>

      {
        shelf.length > 0 ? (
          <>
            <div class="inspired__body">
            <ul class="shelf" role="list">
              {shelf.map((item) => (
                <li class:list={['pin', `pin--${KIND_SHAPE[item.kind]}`, item.placeholder && 'pin--placeholder']}>
                  <svg class="pin__vine" viewBox="0 0 200 24" preserveAspectRatio="none" fill="none" aria-hidden="true">
                    <path d="M0 12C35 4 65 4 100 12S165 20 200 12" />
                  </svg>
                  <span class="pin__string" aria-hidden="true" />
                  <div class="pin__media">
                    {item.image ? <img src={url(item.image)} alt={item.imageAlt} loading="lazy" decoding="async" /> : <Botanical name={KIND_ART[item.kind]} />}
                  </div>
                  <p class="pin__kind">{home.inspired.kinds[item.kind]}</p>
                  <h3 class="pin__name">
                    {item.href ? (
                      <a href={item.href} target="_blank" rel="noopener">
                        {item.name}
                        <span class="visually-hidden"> ({copy.common.newWindow})</span>
                      </a>
                    ) : (
                      item.name
                    )}
                  </h3>
                  {item.by && (
                    <p class="pin__by">
                      {home.inspired.by} {item.by}
                    </p>
                  )}
                  {item.quote && <blockquote class="pin__quote">“{item.quote}”</blockquote>}
                  {item.note && <p class="pin__note">{item.note}</p>}
                </li>
              ))}
            </ul>
            {showPlaceholders ? (
              <p class="draft-note inspired__after">
                <span class="tag tag--draft">{copy.common.placeholder}</span>
                <span>{home.inspired.placeholder.hint}</span>
              </p>
            ) : (
              <p class="inspired__after inspired__disclaimer">{home.inspired.disclaimer}</p>
            )}
            </div>
          </>
        ) : (
          <div class="inspired__empty">
            <span class="inspired__pot" aria-hidden="true">
              <Botanical name="catSeedling" class="js-grow" />
            </span>
            <h3>{home.inspired.empty.title}</h3>
            <p>{home.inspired.empty.body}</p>
          </div>
        )
      }
    </div>
  </section>

  <!-- The ribbon of values, between inspiration and invitation -->
  <ValuesRibbon label={home.values.label} words={home.values.words} />

  <!-- Grow with us: two separate invitations -->
  <section class="section section--sage grow" id="grow-with-us" aria-labelledby="grow-title">
    <div class="container">
      <div class="head head--center">
        <p class="kicker"><Botanical name="sprig" />{home.grow.chapter}</p>
        <h2 class="head__title" id="grow-title">{home.grow.title}</h2>
        {home.grow.paragraphs.map((p) => <p class="head__intro">{p}</p>)}
      </div>

      <div class="grow__paths">
        <div class="path path--feedback">
          <p class="path__label">{home.grow.feedback.label}</p>
          <h3>{home.grow.feedback.title}</h3>
          <p>{home.grow.feedback.body}</p>
          {
            FEEDBACK_URL ? (
              <a class="btn btn--go" href={FEEDBACK_URL} target={feedbackIsWeb ? '_blank' : undefined} rel={feedbackIsWeb ? 'noopener' : undefined}>
                {home.grow.feedback.button}
                <span aria-hidden="true">→</span>
                {feedbackIsWeb && <span class="visually-hidden"> ({copy.common.newWindow})</span>}
              </a>
            ) : (
              <span class="btn" data-disabled>
                <span class="visually-hidden">{home.grow.feedback.button}: </span>
                {home.grow.feedback.missing}
              </span>
            )
          }
        </div>

        <div class="grow__plant" aria-hidden="true">
          <Botanical name="together" class="js-grow" />
        </div>

        <div class="path path--community">
          <p class="path__label">{home.grow.community.label}</p>
          <h3>{home.grow.community.title}</h3>
          <p class="tag tag--gold">{home.grow.community.status}</p>
          <p>{home.grow.community.body}</p>
          <p class="path__choose">{home.grow.community.choose}</p>
          <ul class="path__surveys" role="list">
            {
              surveys.map((survey) => (
                <li lang={survey.lang}>
                  <span class="path__region">{survey.region}</span>
                  {survey.url ? (
                    <a class="btn btn--small" href={survey.url} target="_blank" rel="noopener">
                      {survey.button}
                      <span aria-hidden="true">↗</span>
                      <span class="visually-hidden"> ({copy.common.newWindow})</span>
                    </a>
                  ) : (
                    <span class="btn btn--small" data-disabled>
                      <span class="visually-hidden">{survey.button}: </span>
                      {copy.community.survey.comingSoon}
                    </span>
                  )}
                </li>
              ))
            }
          </ul>
          <a class="text-link" href={localePath(lang, '/community')}>{home.grow.community.more}</a>
        </div>
      </div>

      <div class="grow__ps">
        <span class="grow__ps-art" aria-hidden="true"><Botanical name="catSeedling" /></span>
        <p><span class="grow__ps-label">{home.grow.ps.label}</span> {home.grow.ps.body}</p>
        <a class="btn btn--secondary" href={APP_URL}>{home.grow.ps.button}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Drawings below the first screen grow when they scroll into view. Without this script they are simply there.
  const drawings = document.querySelectorAll('.js-grow');
  if (drawings.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('botanical--grow');
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.35 },
    );
    drawings.forEach((drawing) => observer.observe(drawing));
  }

  // Experience RootMap on phones: the four screens are a carousel. Swiping is the browser's own scroll snapping; this
  // keeps the words and the dots in step with the screen in the middle, and lets the dots, the arrow keys and a tap
  // on a neighbouring screen move it. Without this script each screen simply keeps its words beneath it.
  const stage = document.querySelector<HTMLElement>('.stage');
  const track = stage?.querySelector<HTMLElement>('.journey');
  if (stage && track) {
    const slides = [...track.querySelectorAll<HTMLElement>('.step')];
    const captions = [...stage.querySelectorAll<HTMLElement>('.caption')];
    const dots = [...stage.querySelectorAll<HTMLButtonElement>('.dots button')];
    const phone = window.matchMedia('(max-width: 61.99em)');
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
    let active = 0;
    // The screen a dot or key is heading for: the ones passed on the way there are not announced.
    let heading: number | null = null;

    const show = (index: number) => {
      active = index;
      slides.forEach((slide, i) => slide.toggleAttribute('data-active', i === index));
      captions.forEach((caption, i) => caption.toggleAttribute('data-active', i === index));
      dots.forEach((dot, i) => (i === index ? dot.setAttribute('aria-current', 'true') : dot.removeAttribute('aria-current')));
    };
    // How far a screen's middle is from the middle of the row.
    const offset = (slide: HTMLElement) => {
      const s = slide.getBoundingClientRect();
      const t = track.getBoundingClientRect();
      return s.left + s.width / 2 - (t.left + t.width / 2);
    };
    const nearest = () => slides.reduce((best, slide, i) => (Math.abs(offset(slide)) < Math.abs(offset(slides[best])) ? i : best), 0);
    const goTo = (index: number) => {
      const next = Math.max(0, Math.min(slides.length - 1, index));
      heading = next;
      show(next);
      track.scrollTo({ left: track.scrollLeft + offset(slides[next]), behavior: calm.matches ? 'auto' : 'smooth' });
    };

    let queued = false;
    track.addEventListener(
      'scroll',
      () => {
        if (queued || !phone.matches) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          const index = nearest();
          if (heading !== null) {
            if (index === heading) heading = null;
            return;
          }
          if (index !== active) show(index);
        });
      },
      { passive: true },
    );
    // A finger or the wheel takes over from wherever a dot was heading.
    for (const type of ['touchstart', 'wheel', 'pointerdown']) {
      track.addEventListener(type, () => (heading = null), { passive: true });
    }
    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
    slides.forEach((slide, i) => {
      slide.querySelector<HTMLButtonElement>('.step__arrow')?.addEventListener('click', (event) => {
        event.stopPropagation();
        if (phone.matches) goTo(i + 1);
        else slides[i + 1].scrollIntoView({ behavior: calm.matches ? 'auto' : 'smooth', block: 'nearest', inline: 'center' });
      });
    });
    slides.forEach((slide, i) =>
      slide.addEventListener('click', () => {
        if (phone.matches && i !== active) goTo(i);
      }),
    );
    track.addEventListener('keydown', (event) => {
      if (!phone.matches) return;
      const to = { ArrowRight: active + 1, ArrowLeft: active - 1, Home: 0, End: slides.length - 1 }[event.key];
      if (to === undefined) return;
      event.preventDefault();
      goTo(to);
    });
    stage.dataset.carousel = '';
  }
</script>

