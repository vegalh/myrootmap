  .product :global(.shot img) {
    border-color: rgba(248, 241, 230, 0.22);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.6);
  }
  /* The arrow that leads from one screen to the next */
  .step__arrow {
    position: absolute;
    top: 42%;
    right: calc(var(--space-6) / -2);
    z-index: 3;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    cursor: pointer;
    border-radius: 50%;
    background: var(--gold-400);
    color: var(--green-800);
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1;
    box-shadow: 0 8px 18px -8px rgba(0, 0, 0, 0.6);
    transform: translateX(50%);
  }
  .step__arrow:focus-visible {
    outline: 2px solid var(--white);
    outline-offset: 4px;
  }
  .step__text p:not(.product__kicker) {
    color: rgba(250, 238, 220, 0.86);
    font-size: var(--step--1);
  }
  .step__text .product__lead {
    margin-bottom: var(--space-2);
    color: #fbf2e4;
    font-size: var(--step-0);
    line-height: 1.5;
  }
  .product__kicker {
    color: var(--gold-400);
    font-size: var(--step--1);
    font-weight: 700;
  }
  .product h3 {
    margin-block: var(--space-2) var(--space-3);
    font-family: var(--font-serif);
    font-size: var(--step-3);
    font-weight: 500;
    color: var(--white);
  }
  :lang(zh) .product h3 {
    font-family: var(--font-serif-zh);
    font-weight: 600;
  }
  .product__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    margin-top: clamp(2.5rem, 2rem + 3vw, 4rem);
  }
  .product__note {
    flex-basis: 100%;
    color: rgba(250, 238, 220, 0.72);
    font-size: var(--step--1);
  }
  @media (min-width: 56em) {
    .product__head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-5);
    }
    .product__head .kicker {
      grid-column: 1 / -1;
    }
    .product__title {
      grid-column: 1 / 8;
    }
    .product__intro {
      grid-column: 9 / -1;
      align-self: end;
    }
    .product__note {
      flex-basis: auto;
      margin-left: auto;
    }
  }
  /* Wide screens: all four stand side by side on one stage, overlapping a little, each a step up or down from the last */
  @media (min-width: 62em) {
    .stage {
      display: contents;
    }
    .journey {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-rows: auto auto;
      gap: var(--space-6) var(--space-5);
      margin: 0;
      padding: 0;
      overflow: visible;
      background: none;
    }
    .journey::before {
      content: '';
      grid-area: 1 / 1 / 2 / -1;
      margin-inline: calc(-1 * var(--space-6));
      border-radius: 3rem;
      background: var(--green-700);
    }
    .step {
      --screen-offset: 0rem;
      grid-row: 1 / 3;
      grid-template-rows: subgrid;
      gap: var(--space-6);
    }
    .step:nth-child(1) {
      grid-column: 1;
    }
    .step:nth-child(2) {
      grid-column: 2;
    }
    .step:nth-child(3) {
      grid-column: 3;
    }
    .step:nth-child(4) {
      grid-column: 4;
    }
    .step__shot {
      display: grid;
      justify-items: center;
      padding-block: 2.5rem 5.5rem;
    }
    .step:nth-child(even) {
      --screen-offset: 0rem;
    }
    .step:nth-child(even) .step__shot {
      padding-block: 5.5rem 2.5rem;
    }
    .step__shot :global(.shot) {
      width: 114%;
    }

    .step__arrow {
      top: 50%;
      right: calc(var(--space-5) / -2);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .step:hover .step__shot :global(.shot) {
      transform: translateY(calc(var(--screen-offset) - 0.4rem)) rotate(var(--screen-angle));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .step__shot :global(.shot) { transition: none; }
  }

  /* A little note from the founder */
  .founder {
    position: relative;
  }
  /* The arrow that leads down from the app into the note */
  .founder__lead-in {
    position: absolute;
    top: calc(-1 * clamp(1.5rem, 3vw, 3rem));
    left: 50%;
    z-index: 2;
    width: clamp(2.75rem, 5vw, 4rem);
    transform: translateX(-50%);
  }
  .founder__lead-in path {
    stroke: var(--terracotta-500);
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .founder__lead-in .founder__lead-leaf {
    fill: var(--terracotta-500);
    stroke: none;
  }
  /* The note: a sheet of paper held with a strip of tape */
  .founder__note {
    position: relative;
    display: grid;
    gap: var(--space-6);
    max-width: 72rem;
    margin: var(--space-6) auto 0;
  }
  :global(.founder__sprig) {
    position: absolute;
    top: 0;
    right: 0;
    width: 4rem;
  }
  .founder__head {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    text-align: center;
    padding-inline: 2rem;
  }
  .founder__title { font-size: var(--step-4); }
  .founder__constellation { position: relative; }
  .founder__art {
    position: relative;
    isolation: isolate;
    width: clamp(12rem, 26vw, 19rem);
    margin: var(--space-5) auto var(--space-7);
  }
  .founder__patch {
    position: absolute;
    z-index: -1;
    inset: -7% -9% -5%;
    border-radius: 45% 55% 42% 58% / 56% 44% 56% 44%;
    background: var(--sage-200);
    transform: rotate(-9deg);
  }
  section :global(.founder__photo) {
    --figure-radius: 48% 52% 46% 54% / 55% 44% 56% 45%;
    --figure-placeholder-bg: var(--white);
  }
  :global(.founder__photo .figure__label) {
    left: 0;
    right: 0;
    bottom: 16%;
    align-items: center;
  }
  :global(.founder__photo .figure__label code) { display: none; }
  :global(.founder__vine) {
    position: absolute;
    right: -12%;
    bottom: -10%;
    width: 32%;
    transform: scaleX(-1);
  }
  .founder__thoughts {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
  }
  .founder__thoughts li {
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--green-700);
    text-align: center;
    text-wrap: balance;
    transform: rotate(-3deg);
  }
  .founder__thoughts li:nth-child(even) {
    color: var(--terracotta-700);
    transform: rotate(3deg);
  }
  .founder__thoughts li::after {
    content: '';
    display: block;
    width: 2.5rem;
    height: 1px;
    margin: 0.85rem auto 0;
    background: currentColor;
    opacity: 0.4;
    transform: rotate(-8deg);
  }
  :lang(zh) .founder__thoughts li { font-family: var(--font-serif-zh); }
  .founder__words {
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
  }
  .founder__body {
    color: var(--ink-soft);
    font-size: var(--step-1);
    line-height: 1.75;
    text-wrap: pretty;
  }
  .founder__sign { margin-top: var(--space-4); font-family: var(--font-serif); }
  @media (min-width: 62em) {
    .founder__constellation {
      display: grid;
      grid-template-columns: 1fr 1.1fr 1fr;
      grid-template-rows: repeat(3, minmax(6.5rem, auto));
      gap: var(--space-5) var(--space-6);
      align-items: center;
      padding-block: var(--space-5);
    }
    .founder__art { grid-area: 1 / 2 / 4 / 3; width: 100%; margin: 0; }
    .founder__thoughts { display: contents; }
    .founder__thoughts li:nth-child(odd) { grid-column: 1; }
    .founder__thoughts li:nth-child(even) { grid-column: 3; }
    .founder__thoughts li:nth-child(-n + 2) { grid-row: 1; }
    .founder__thoughts li:nth-child(n + 3):nth-child(-n + 4) { grid-row: 2; }
    .founder__thoughts li:nth-child(n + 5) { grid-row: 3; }
    .founder__thoughts li:nth-child(3) { transform: translateX(-1rem) rotate(2deg); }
    .founder__thoughts li:nth-child(4) { transform: translateX(1rem) rotate(-2deg); }
  }

  .founder__shaped {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    max-width: 46rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--sage-100);
    border-radius: 2rem 0.75rem 2rem 0.75rem;
    text-align: center;
  }
  .founder__shaped h3 {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    font-weight: 500;
    color: var(--green-700);
  }
  :lang(zh) .founder__shaped h3 { font-family: var(--font-serif-zh); }
  .founder__shaped p { color: var(--ink-soft); line-height: 1.65; }
  .founder__shaped .btn { margin-top: var(--space-2); }

  /* Connect, and the places it leads to */
  .founder__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }
  .founder__channels {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .channel {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--sage-300);
    border-radius: 999px;
    background: var(--sage-100);
    color: var(--green-700);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
  }
  a.channel:hover {
    border-color: var(--green-500);
  }
  .channel--soon {
    border-style: dashed;
    border-color: var(--line-strong);
    background: none;
    color: var(--muted);
  }
  @media (min-width: 48em) {
    .founder__actions .text-link {
      margin-left: auto;
    }
    .founder__channels {
      flex: 1;
    }
  }

  /* Explore more with us: three destinations, each with its own character */
  .explore__mosaic {
    display: grid;
    gap: var(--space-5);
  }
  .dest {
    position: relative;
    display: grid;
    gap: var(--space-6);
    align-content: start;
    padding: clamp(1.5rem, 1rem + 2.4vw, 2.75rem);
    border-radius: 2rem;
    transition: transform 0.4s var(--ease);
  }
  .dest:has(a.dest__cta):hover {
    transform: translateY(-4px);
  }
  .dest__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .dest__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    font-family: var(--font-serif);
    font-size: var(--step-3);
    font-weight: 500;
    line-height: 1.1;
  }
  :lang(zh) .dest__name {
    font-family: var(--font-serif-zh);
    font-weight: 600;
  }
  .dest__native {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 700;
    opacity: 0.75;
  }
  .dest__tagline {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    font-style: italic;
    line-height: 1.4;
  }
  :lang(zh) .dest__tagline {
    font-family: var(--font-serif-zh);
    font-style: normal;
  }
  .dest__topics {
    margin-block: var(--space-2);
    font-size: var(--step--1);
  }
  /* The link covers its whole panel, so the panel is one large target */
  .dest__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--step-0);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 6px;
  }
  a.dest__cta::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .dest__cta span[aria-hidden] {
    transition: transform 0.25s var(--ease);
  }
  .dest:hover a.dest__cta span[aria-hidden] {
    transform: translateX(4px);
  }
  .dest__cta--missing {
    padding: 0.45rem 0.9rem;
    border: 1px dashed currentColor;
    border-radius: 999px;
    font-size: var(--step--1);
    text-decoration: none;
    opacity: 0.8;
  }
  .dest__media {
    position: relative;
  }

  /* Xiaohongshu: a snapshot, like a post */
  .dest--xhs {
    border-top-left-radius: 5rem;
    background: color-mix(in srgb, var(--terracotta-500) 24%, var(--paper));
  }
  .dest--xhs .dest__name,
  .dest--xhs .dest__cta {
    color: var(--terracotta-700);
  }
  .dest--xhs .dest__media {
    width: min(70%, 19rem);
    margin: var(--space-3) auto var(--space-2);
  }
  .dest__snap {
    position: relative;
    padding: 0.55rem 0.55rem 1.9rem;
    border-radius: 0.5rem;
    background: var(--white);
    box-shadow: 0 18px 36px -22px rgba(43, 37, 32, 0.5);
    transform: rotate(2.5deg);
    transition: transform 0.5s var(--ease);
  }
  .dest__snap :global(.figure) {
    --figure-radius: 0.3rem;
  }
  .dest__snap--back {
    position: absolute;
    inset: 0;
    padding: 0;
    background: var(--cream-100);
    transform: rotate(-6deg) translate(-7%, 2%);
  }
  .dest--xhs:hover .dest__snap:not(.dest__snap--back) {
    transform: rotate(0.5deg) translateY(-3px);
  }
  .dest--xhs:hover .dest__snap--back {
    transform: rotate(-9deg) translate(-10%, 2%);
  }
  .dest__topics--dots {
    display: grid;
    gap: 0.3rem;
  }
  .dest__topics--dots li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .dest__topics--dots li::before {
    content: '';
    flex-shrink: 0;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--terracotta-500);
    transform: translateY(-0.1em);
  }

  /* Blog: a written page */
  .dest--blog {
    border-top-right-radius: 5rem;
    background: var(--green-700);
    color: rgba(250, 238, 220, 0.9);
  }
  .dest--blog .dest__name {
    color: var(--white);
  }
  .dest--blog .dest__tagline,
  .dest--blog .dest__cta {
    color: var(--gold-400);
  }
  .dest--blog :focus-visible {
    outline-color: var(--gold-400);
  }
  .dest__topics--lines {
    width: 100%;
    max-width: 24rem;
  }
  .dest__topics--lines li {
    padding-block: 0.4rem;
    border-bottom: 1px solid rgba(248, 241, 230, 0.2);
  }
  .dest__latest {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.6rem;
    font-size: var(--step--1);
  }
  .dest__latest span {
    color: var(--gold-400);
    font-weight: 700;
  }
  .dest--blog .dest__media {
    width: min(86%, 22rem);
    margin-inline: auto;
  }
  .dest__sheet {
    position: absolute;
    inset: -5% 4% 5% -6%;
    border-radius: 0.4rem;
    background: repeating-linear-gradient(to bottom, transparent 0 1.05rem, var(--line) 1.05rem calc(1.05rem + 1px)), var(--cream-100);
    transform: rotate(-5deg);
    transition: transform 0.5s var(--ease);
  }
  .dest--blog .dest__media :global(.figure) {
    position: relative;
    transform: rotate(2deg);
    transition: transform 0.5s var(--ease);
    --figure-radius: 0.4rem;
    --figure-placeholder-bg: var(--white);
  }
  .dest--blog:hover .dest__sheet {
    transform: rotate(-8deg);
  }
  .dest--blog:hover .dest__media :global(.figure) {
    transform: rotate(0.5deg);
  }

  /* Resources: a table of specimens */
  .dest--resources {
    border-bottom-right-radius: 5rem;
    background: var(--sage-200);
  }
  .dest__topics--tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .dest__topics--tags li {
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: var(--white);
    color: var(--green-700);
    font-weight: 600;
  }
  .dest--resources .dest__cta {
    color: var(--green-700);
  }
  .dest--resources .dest__media {
    width: min(86%, 22rem);
    margin: var(--space-3) auto;
  }
  .dest--resources .dest__media :global(.figure) {
    --figure-radius: 42% 58% 46% 54% / 52% 44% 56% 48%;
    --figure-placeholder-bg: var(--white);
  }
  :global(.dest--resources .figure__label) {
    left: 22%;
    bottom: 16%;
  }
  .dest__specimen {
    position: absolute;
    display: grid;
    place-items: center;
    width: 26%;
    aspect-ratio: 1;
    border-radius: 58% 42% 55% 45% / 48% 56% 44% 52%;
    background: var(--gold-100);
    transition: transform 0.5s var(--ease);
  }
  .dest__specimen :global(.botanical) {
    width: 74%;
  }
  .dest__specimen--a {
    top: -8%;
    left: -6%;
  }
  .dest__specimen--b {
    right: -8%;
    top: 30%;
    background: var(--cream-100);
  }
  .dest__specimen--c {
    left: 10%;
    bottom: -10%;
    width: 22%;
    background: var(--white);
  }
  .dest--resources:hover .dest__specimen--a {
    transform: rotate(-10deg);
  }
  .dest--resources:hover .dest__specimen--b {
    transform: rotate(8deg) translateX(3px);
  }
  .dest--resources:hover .dest__specimen--c {
    transform: rotate(-6deg) translateY(3px);
  }
  @media (min-width: 40em) {
    .dest--blog,
    .dest--resources {
      grid-template-columns: 1.1fr 1fr;
      align-items: center;
    }
    .dest--resources {
      grid-template-columns: 1fr 1.1fr;
    }
    .dest--blog .dest__media,
    .dest--resources .dest__media {
      width: 86%;
    }
    .dest__body {
      height: 100%;
    }
  }
  @media (min-width: 62em) {
    .explore__mosaic {
      grid-template-columns: 5fr 7fr;
    }
    .dest--xhs {
      grid-column: 2;
      grid-row: 1 / 3;
      grid-template-rows: auto 1fr;
    }
  }

  /* Inspired by: the label on one side, the collection clustered beside it */
  .inspired__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .inspired__head {
    justify-items: center;
    text-align: center;
  }
  .shelf {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    row-gap: var(--space-7);
  }
  .pin {
    position: relative;
    display: flex;
    flex: 0 0 50%;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: 0 var(--space-3);
    text-align: center;
    --string: 1.5rem;
    --tilt: -2deg;
  }
  .pin:nth-child(even) {
    --string: 2.75rem;
    --tilt: 2.5deg;
  }
  .pin:nth-child(3n) {
    --string: 2.1rem;
    --tilt: -1deg;
  }
  /* Each piece carries its own length of vine; side by side they join into one */
  .pin__vine {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 24px;
    color: var(--green-600);
  }
  .pin__vine path {
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .pin__string {
    width: 1.5px;
    height: var(--string);
    margin-top: 12px;
    background: var(--green-600);
  }
  .pin__media {
    display: grid;
    place-items: center;
    width: 6.5rem;
    aspect-ratio: 1;
    margin-top: calc(-1 * var(--space-2));
    margin-bottom: var(--space-2);
    overflow: hidden;
    border-radius: 50%;
    background: var(--sage-200);
    box-shadow: var(--shadow-sm);
    transform: rotate(var(--tilt));
    transform-origin: 50% 0;
    transition: transform 0.6s var(--ease);
  }
  .pin:hover .pin__media {
    transform: rotate(calc(var(--tilt) * -1));
  }
  .pin__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pin__media :global(.botanical) {
    width: 62%;
  }
  .pin--cover .pin__media {
    width: 5.5rem;
    aspect-ratio: 2 / 3;
    border-radius: 0.3rem 0.6rem 0.6rem 0.3rem;
    background: var(--gold-100);
  }
  .pin--logo .pin__media {
    width: 9rem;
    aspect-ratio: 2 / 1;
    padding: 1rem;
    border-radius: 0.75rem;
    background: var(--white);
  }
  .pin--logo .pin__media img {
    object-fit: contain;
  }
  .pin--idea .pin__media {
    border-radius: 58% 42% 55% 45% / 48% 56% 44% 52%;
    background: var(--white);
  }
  .pin--placeholder .pin__media {
    border: 1.5px dashed var(--line-strong);
    background: var(--paper);
    box-shadow: none;
    --bot-stem: var(--line-strong);
    --bot-leaf-a: var(--line-strong);
    --bot-leaf-b: var(--line);
