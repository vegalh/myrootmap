---
// The homepage, told in five chapters: Introduction, The way we see childhood, RootMap in everyday life,
// Notes on growing (blog and resources) and Grow with us (the community, and a way into the app).
import '@fontsource-variable/fraunces/wght-italic.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Figure from '../components/Figure.astro';
import Screenshot from '../components/Screenshot.astro';
import { formatDate, localePath, t, type Lang } from '../i18n';
import { APP_URL } from '../config/site';
import { IMAGES, SCREENSHOTS } from '../config/images';
import { getPublishedPosts, postUrl } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
const home = copy.home;
const [featured, ...morePosts] = await getPublishedPosts(lang, 3);
const resourceCategories = Object.values(copy.categories.resources);
const pad = (n: number) => String(n).padStart(2, '0');
const contents = [
  { id: 'childhood', name: home.childhood.chapter },
  { id: 'everyday-life', name: home.product.chapter },
  { id: 'notes', name: home.notes.chapter },
  { id: 'grow-with-us', name: home.community.chapter },
];
---

<BaseLayout lang={lang} title={home.title} fullTitle>
  <!-- Chapter 1: Introduction -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <p class="chapter hero__chapter"><span class="chapter__num">01</span><span class="chapter__name">{home.hero.chapter}</span></p>
      <h1 class="hero__title" id="hero-title">
        {home.hero.titleLines.map((line) => <span class="hero__line">{line}</span>)}
      </h1>
      <div class="hero__text">
        <p class="hero__eyebrow">{home.hero.eyebrow}</p>
        <p class="hero__lead">{home.hero.body}</p>
        <div class="hero__actions">
          <a class="btn btn--go" href={APP_URL}>{home.hero.primary}<span aria-hidden="true">→</span></a>
          <a class="text-link" href={localePath(lang, '/features')}>{home.hero.secondary}</a>
        </div>
      </div>
      <nav class="hero__contents" aria-label={home.contentsLabel}>
        <p class="label">{home.contentsLabel}</p>
        <ol role="list">
          {
            contents.map((item, i) => (
              <li>
                <a href={`#${item.id}`}>
                  <span class="chapter__num">{pad(i + 2)}</span>
                  {item.name}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      <Figure class="hero__media" image={IMAGES.homeHero} alt={home.hero.imageAlt} caption={home.hero.caption} placeholder={copy.common.imagePlaceholder} eager />
    </div>
  </section>

  <!-- Chapter 2: The way we see childhood -->
  <section class="section childhood" id="childhood" aria-labelledby="childhood-title">
    <div class="container childhood__grid">
      <p class="chapter childhood__chapter"><span class="chapter__num">02</span><span class="chapter__name">{home.childhood.chapter}</span></p>
      <h2 class="childhood__title" id="childhood-title">{home.childhood.title}</h2>
      <div class="childhood__intro">
        {home.childhood.intro.map((p) => <p>{p}</p>)}
      </div>
      <Figure class="childhood__main" image={IMAGES.homeChildhoodMain} alt={home.childhood.mainAlt} caption={home.childhood.mainCaption} placeholder={copy.common.imagePlaceholder} />
      <blockquote class="childhood__quote">
        <p>{home.childhood.quote}</p>
      </blockquote>
      <Figure class="childhood__detail" image={IMAGES.homeChildhoodDetail} alt={home.childhood.detailAlt} caption={home.childhood.detailCaption} placeholder={copy.common.imagePlaceholder} />
      <div class="childhood__ideas">
        <h3 class="label">{home.childhood.ideasLabel}</h3>
        <dl class="ideas">
          {
            home.childhood.ideas.map((idea) => (
              <div>
                <dt>{idea.title}</dt>
                <dd>{idea.body}</dd>
              </div>
            ))
          }
        </dl>
        <a class="text-link" href={localePath(lang, '/philosophy')}>{home.childhood.link}</a>
      </div>
    </div>
  </section>

  <!-- Chapter 3: RootMap in everyday life -->
  <section class="section section--forest product" id="everyday-life" aria-labelledby="product-title">
    <div class="container">
      <div class="product__head">
        <p class="chapter"><span class="chapter__num">03</span><span class="chapter__name">{home.product.chapter}</span></p>
        <h2 class="product__title" id="product-title">{home.product.title}</h2>
        <p class="product__intro">{home.product.intro}</p>
      </div>
      <div class="product__show">
        <div class="product__stage">
          <Screenshot src={SCREENSHOTS[home.product.featured.id]} alt={home.product.featured.shotAlt} placeholder={copy.common.screenshotPlaceholder} />
        </div>
        <div class="product__featured">
          <p class="product__kicker">{home.product.featured.kicker}</p>
          <h3>{home.product.featured.title}</h3>
          <p class="product__lead">{home.product.featured.lead}</p>
          <p>{home.product.featured.body}</p>
        </div>
        <ul class="product__more" role="list">
          {
            home.product.supporting.map((item) => (
              <li>
                <Screenshot src={SCREENSHOTS[item.id]} alt={item.shotAlt} placeholder={copy.common.screenshotPlaceholder} />
                <div>
                  <p class="product__kicker">{item.kicker}</p>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="product__foot">
        <a class="btn btn--light btn--go" href={APP_URL}>{home.product.app}<span aria-hidden="true">→</span></a>
        <a class="text-link" href={localePath(lang, '/features')}>{home.product.link}</a>
        <p class="product__note">{home.product.demoNote}</p>
      </div>
    </div>
  </section>

  <!-- Chapter 4: Notes on growing -->
  <section class="section section--cream notes" id="notes" aria-labelledby="notes-title">
    <div class="container notes__grid">
      <div class="notes__head">
        <p class="chapter"><span class="chapter__num">04</span><span class="chapter__name">{home.notes.chapter}</span></p>
        <h2 class="notes__title" id="notes-title">{home.notes.title}</h2>
        <p class="notes__intro">{home.notes.intro}</p>
      </div>

      <div class="notes__blog">
        <h3 class="label">{home.notes.featuredLabel}</h3>
        {
          featured ? (
            <article class="feature">
              <a href={postUrl(featured)} class="feature__media" tabindex="-1" aria-hidden="true">
                <Figure image={{ src: featured.data.cover ?? '', ratio: '16 / 10', folder: 'blog' }} alt={featured.data.coverAlt} placeholder={copy.common.imagePlaceholder} />
              </a>
              <p class="feature__meta">
                <span>{copy.categories.blog[featured.data.category]}</span>
                {featured.data.date && <time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date, lang)}</time>}
              </p>
              <h4 class="feature__title">
                <a href={postUrl(featured)}>{featured.data.title}</a>
              </h4>
              <p class="feature__desc">{featured.data.description}</p>
            </article>
          ) : (
            <div class="feature feature--placeholder">
              <Figure image={{ src: '', ratio: '16 / 10', folder: 'blog' }} alt="" placeholder={copy.common.imagePlaceholder} />
              <p class="tag tag--draft">{home.notes.placeholderTag}</p>
              <p class="feature__desc">{home.notes.empty}</p>
            </div>
          )
        }
        {
          morePosts.length > 0 && (
            <>
              <h3 class="label notes__more-label">{home.notes.moreLabel}</h3>
              <ul class="stories" role="list">
                {morePosts.map((post) => (
                  <li class="story">
                    <a href={postUrl(post)} class="story__media" tabindex="-1" aria-hidden="true">
                      <Figure image={{ src: post.data.cover ?? '', ratio: '4 / 3', folder: 'blog' }} alt={post.data.coverAlt} placeholder={copy.common.imagePlaceholder} />
                    </a>
                    <div>
                      <p class="feature__meta">
                        <span>{copy.categories.blog[post.data.category]}</span>
                        {post.data.date && <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>}
                      </p>
                      <h4 class="story__title">
                        <a href={postUrl(post)}>{post.data.title}</a>
                      </h4>
                    </div>
                  </li>
                ))}
              </ul>
            </>
          )
        }
        <a class="text-link" href={localePath(lang, '/blog')}>{home.notes.blogLink}</a>
      </div>

      <aside class="notes__library" aria-labelledby="library-title">
        <h3 class="notes__library-title" id="library-title">{home.notes.resourcesTitle}</h3>
        <p>{home.notes.resourcesIntro}</p>
        <ol class="library" role="list">
          {
            resourceCategories.map((cat, i) => (
              <li>
                <span class="library__num" aria-hidden="true">{pad(i + 1)}</span>
                <span>
                  <span class="library__name">{cat.title}</span>
                  <span class="library__body">{cat.body}</span>
                </span>
              </li>
            ))
          }
        </ol>
        <p class="notes__note">{home.notes.resourcesNote}</p>
        <a class="text-link" href={localePath(lang, '/resources')}>{home.notes.resourcesLink}</a>
      </aside>
    </div>
  </section>

  <!-- Chapter 5: Grow with us -->
  <section class="section invite" id="grow-with-us" aria-labelledby="invite-title">
    <div class="container invite__grid">
      <p class="chapter invite__chapter"><span class="chapter__num">05</span><span class="chapter__name">{home.community.chapter}</span></p>
      <Figure class="invite__media" image={IMAGES.homeCommunity} alt={home.community.imageAlt} placeholder={copy.common.imagePlaceholder} />
      <div class="invite__letter">
        <p class="tag tag--gold">{home.community.status}</p>
        <h2 class="invite__title" id="invite-title">{home.community.title}</h2>
        {home.community.paragraphs.map((p) => <p class="invite__body">{p}</p>)}
        <div class="invite__cta">
          <a class="btn btn--go" href={localePath(lang, '/community')}>{home.community.cta}<span aria-hidden="true">→</span></a>
          <p>{home.community.ctaNote}</p>
        </div>
        <div class="invite__ps">
          <p><span class="invite__ps-label">{home.community.ps.label}</span> {home.community.ps.body}</p>
          <a class="btn btn--secondary" href={APP_URL}>{home.community.ps.button}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Shared pieces for the chapters */
  .chapter {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    color: var(--muted);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  :lang(zh) .chapter {
    font-size: var(--step--1);
    letter-spacing: 0.1em;
  }
  .chapter__num {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--terracotta-700);
  }
  .chapter::after {
    content: '';
    flex: 1;
    height: 1px;
    align-self: center;
    background: var(--line-strong);
  }
  .label {
    color: var(--muted);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  :lang(zh) .label {
    font-size: var(--step--1);
    letter-spacing: 0.08em;
  }

  /* Editorial photographs on this page: barely rounded, on a quiet paper-toned placeholder */
  section :global(.figure) {
    --figure-radius: 3px;
    --figure-placeholder-bg: var(--cream-200);
    --figure-placeholder-ink: var(--line-strong);
  }
  section :global(.figure img) {
    transition: transform 0.9s var(--ease);
  }
  section :global(figcaption) {
    max-width: 30rem;
    padding-left: var(--space-3);
    border-left: 1px solid var(--terracotta-500);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  /* A button with an arrow that moves a little on hover */
  .btn--go span {
    transition: transform 0.25s var(--ease);
  }
  .btn--go:hover span {
    transform: translateX(3px);
  }
  .btn:active {
    transform: translateY(1px);
  }

  /* Chapter 1: Introduction */
  .hero {
    padding-block: clamp(1.75rem, 1rem + 3vw, 3.5rem) clamp(1rem, 3vw, 2.5rem);
  }
  .hero__grid {
    display: grid;
    gap: var(--space-6);
  }
  .hero__title {
    display: flex;
    flex-direction: column;
    font-size: clamp(2.7rem, 0.9rem + 6.2vw, 6.75rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-wrap: initial;
  }
  .hero__line:last-child {
    padding-left: 0.9em;
    font-style: italic;
    font-weight: 400;
    color: var(--terracotta-700);
  }
  :lang(zh) .hero__title {
    font-size: clamp(2.4rem, 1rem + 5vw, 5.5rem);
    line-height: 1.2;
    letter-spacing: 0.02em;
  }
  :lang(zh) .hero__line:last-child {
    font-style: normal;
  }
  .hero__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .hero__eyebrow {
    color: var(--green-700);
    font-weight: 700;
  }
  .hero__lead {
    max-width: 30rem;
    color: var(--ink-soft);
    font-size: var(--step-1);
    line-height: 1.6;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-3);
  }
  :global(.hero__media) {
    margin-right: calc(-1 * var(--gutter));
    margin-left: 12%;
    --figure-ratio: 5 / 4;
  }
  :global(.hero__media) :global(figcaption) {
    margin-right: var(--gutter);
  }
  .hero__contents {
    display: none;
  }
  @media (max-width: 35.99em) {
    .hero__actions .btn {
      flex-basis: 100%;
      min-height: 3.25rem;
    }
  }
  @media (min-width: 56em) {
    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-5);
      row-gap: var(--space-7);
    }
    .hero__chapter,
    .hero__title {
      grid-column: 1 / -1;
    }
    .hero__contents {
      grid-column: 1 / 5;
      grid-row: 3;
      align-self: end;
      display: grid;
      gap: var(--space-3);
      margin-bottom: var(--space-7);
    }
    .hero__contents li {
      border-bottom: 1px solid var(--line);
    }
    .hero__contents a {
      display: flex;
      align-items: baseline;
      gap: var(--space-3);
      padding-block: 0.7rem;
      color: var(--ink-soft);
      font-size: var(--step--1);
      font-weight: 600;
      text-decoration: none;
      transition:
        color 0.2s var(--ease),
        padding 0.25s var(--ease);
    }
    .hero__contents a:hover {
      padding-left: var(--space-2);
      color: var(--green-700);
    }
    .hero__text {
      grid-column: 1 / 6;
      grid-row: 3;
      align-self: start;
      padding-top: var(--space-5);
      border-top: 1px solid var(--line-strong);
    }
    :global(.hero__media) {
      grid-column: 8 / -1;
      grid-row: 3;
      margin-left: 0;
      margin-right: calc((min(100vw - 2 * var(--gutter), var(--container)) - 100vw) / 2);
      --figure-ratio: 4 / 5;
    }
    :global(.hero__media) :global(figcaption) {
      margin-right: 0;
    }
    .hero__line:last-child {
      padding-left: 1.6em;
    }
  }

  /* Chapter 2: The way we see childhood */
  .childhood__grid {
    display: grid;
    gap: var(--space-6);
  }
  .childhood__title {
    max-width: 14ch;
    font-size: var(--step-4);
  }
  :lang(zh) .childhood__title {
    max-width: 12em;
  }
  .childhood__intro {
    display: grid;
    gap: var(--space-4);
    max-width: 34rem;
    color: var(--ink-soft);
  }
  .childhood__intro p:first-child {
    color: var(--ink);
    font-size: var(--step-1);
    line-height: 1.55;
  }
  :global(.childhood__main) {
    margin-inline: calc(-1 * var(--gutter));
  }
  :global(.childhood__main) :global(figcaption) {
    margin-inline: var(--gutter);
  }
  .childhood__quote {
    margin-block: var(--space-4);
    font-family: var(--font-serif);
    font-size: var(--step-3);
    font-style: italic;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--green-700);
  }
  .childhood__quote p::before {
    content: '“';
    display: block;
    height: 0.55em;
    color: var(--terracotta-500);
    font-size: 2em;
    line-height: 1;
  }
  :lang(zh) .childhood__quote {
    font-family: var(--font-serif-zh);
    font-style: normal;
    font-size: var(--step-2);
    line-height: 1.6;
  }
  /* On phones the detail photograph sits beside its caption */
  :global(.childhood__detail) {
    display: grid;
    grid-template-columns: 9fr 7fr;
    gap: var(--space-4);
    align-items: end;
  }
  :global(.childhood__detail) :global(figcaption) {
    margin: 0;
  }
  .childhood__ideas {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .ideas {
    display: grid;
    width: 100%;
    border-top: 1px solid var(--line-strong);
  }
  .ideas > div {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--line);
  }
  .ideas dt {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    font-weight: 500;
    color: var(--green-700);
  }
  :lang(zh) .ideas dt {
    font-family: var(--font-serif-zh);
    font-weight: 600;
  }
  .ideas dd {
    max-width: 30rem;
    color: var(--ink-soft);
  }
  @media (min-width: 40em) {
    .ideas {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-6);
    }
  }
  @media (min-width: 56em) {
    .childhood__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-5);
      row-gap: var(--space-8);
    }
    .childhood__chapter {
      grid-column: 1 / -1;
      margin-bottom: calc(var(--space-7) - var(--space-8));
    }
    .childhood__title {
      grid-column: 1 / 8;
    }
    .childhood__intro {
      grid-column: 8 / -1;
      align-self: end;
    }
    :global(.childhood__main) {
      grid-column: 1 / 8;
      margin-right: 0;
      margin-left: calc((min(100vw - 2 * var(--gutter), var(--container)) - 100vw) / 2);
    }
    :global(.childhood__main) :global(figcaption) {
      margin-inline: calc((100vw - min(100vw - 2 * var(--gutter), var(--container))) / 2) 0;
    }
    .childhood__quote {
      grid-column: 9 / -1;
      align-self: center;
      margin: 0;
    }
    :global(.childhood__detail) {
      grid-column: 2 / 5;
      display: block;
      align-self: start;
      margin-top: var(--space-8);
    }
    :global(.childhood__detail) :global(figcaption) {
      margin-top: var(--space-3);
    }
    .childhood__ideas {
      grid-column: 6 / -1;
    }
  }

  /* Chapter 3: RootMap in everyday life */
  .product .chapter {
    color: rgba(248, 241, 230, 0.7);
  }
  .product .chapter__num {
    color: var(--gold-400);
  }
  .product .chapter::after {
    background: rgba(248, 241, 230, 0.22);
  }
  .product__head {
    display: grid;
    gap: var(--space-5);
    margin-bottom: clamp(2.5rem, 1.5rem + 4vw, 5rem);
  }
  .product__title {
    max-width: 18ch;
    font-size: var(--step-4);
  }
  :lang(zh) .product__title {
    max-width: 14em;
  }
  .product__intro {
    max-width: 32rem;
    color: rgba(248, 241, 230, 0.82);
    font-size: var(--step-1);
  }
  .product__show {
    display: grid;
    gap: var(--space-7);
  }
  .product__stage {
    display: grid;
    place-items: center;
    padding-block: var(--space-7);
    margin-inline: calc(-1 * var(--gutter));
    background: var(--green-700);
  }
  .product__stage :global(.shot) {
    width: 68%;
    max-width: 21rem;
  }
  .product :global(.shot img) {
    border-color: rgba(248, 241, 230, 0.18);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.55);
  }
  .product__kicker {
    color: var(--gold-400);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  :lang(zh) .product__kicker {
    font-size: var(--step--1);
    letter-spacing: 0.08em;
  }
  .product h3 {
    margin-block: var(--space-2) var(--space-3);
    font-family: var(--font-serif);
    font-weight: 500;
    color: var(--white);
  }
  :lang(zh) .product h3 {
    font-family: var(--font-serif-zh);
    font-weight: 600;
  }
  .product__featured h3 {
    font-size: var(--step-4);
  }
  .product__featured p:not(.product__kicker) {
    max-width: 30rem;
    color: rgba(248, 241, 230, 0.82);
  }
  .product__featured .product__lead {
    margin-bottom: var(--space-3);
    color: var(--cream-100);
    font-size: var(--step-1);
    line-height: 1.5;
  }
  /* Phones: the two supporting previews sit side by side, text under each */
  .product__more {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
  }
  .product__more li {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }
  .product__more :global(.shot) {
    max-width: 9.5rem;
    transition: transform 0.4s var(--ease);
  }
  .product__more li:hover :global(.shot) {
    transform: translateY(-4px);
  }
  .product__more h3 {
    font-size: var(--step-2);
  }
  .product__more p:not(.product__kicker) {
    color: rgba(248, 241, 230, 0.78);
    font-size: var(--step--1);
  }
  .product__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
