---
// The homepage, in five short sections: hero, how it works, two real activities, who it is for, and the founder strip
// with the invite form. Copy: `home` in src/i18n. Image slots: src/config/images.ts. Invite form links: src/config/site.ts.
// The longer blocks that used to be here are in src/components/sections/ and shown on Our Philosophy, About and Community.
import '@fontsource-variable/fraunces/wght-italic.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Botanical from '../components/Botanical.astro';
import Figure from '../components/Figure.astro';
import Screenshot from '../components/Screenshot.astro';
import { localePath, t, type Lang } from '../i18n';
import { INVITE_FORM_URLS, SHOW_DESIGN_PLACEHOLDERS } from '../config/site';
import { IMAGES, SCREENSHOTS } from '../config/images';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
const home = copy.home;
const formUrl = INVITE_FORM_URLS[lang];
---

<BaseLayout lang={lang} title={home.title} fullTitle>
  <!-- 1. Hero: words on one side, a layered picture on the other (the photograph, with the app tucked over its corner) -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="kicker"><Botanical name="sprig" />{home.hero.eyebrow}</p>
        <h1 class="hero__title" id="hero-title">
          {
            home.hero.titleLines.map((line) => (
              <>
                <span class="hero__line">{line}</span>{lang === 'zh' ? '' : ' '}
              </>
            ))
          }
        </h1>
        <p class="hero__lead">{home.hero.body}</p>
        <div class="hero__actions">
          <a class="btn btn--go" href="#invite">{copy.common.cta}<span aria-hidden="true">→</span></a>
          <a class="text-link" href="#how">{home.hero.secondary}</a>
        </div>
        <p class="hero__access">{home.hero.access}</p>
      </div>
      <div class="hero__art">
        <span class="hero__patch" aria-hidden="true"></span>
        <span class="hero__sun" aria-hidden="true"></span>
        <Figure class="hero__media" image={IMAGES.homeHero} alt={home.hero.imageAlt} placeholder={copy.common.imagePlaceholder} eager />
        <div class="hero__shot">
          <Screenshot src={SCREENSHOTS.today} alt={home.hero.shotAlt} placeholder={copy.common.screenshotPlaceholder} />
        </div>
        <Botanical name="heroVine" class="hero__vine" grow />
      </div>
    </div>
  </section>

  <!-- 2. How it works: four steps in one row, stacked on phones -->
  <section class="section section--forest how" id="how" aria-labelledby="how-title">
    <svg class="wave wave--top" viewBox="0 0 1440 48" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 48V24C190 2 380 42 640 27S1130 0 1440 21V48Z" fill="currentColor"></path>
    </svg>
    <Botanical name="edgeVine" class="how__vine" />
    <div class="container how__inner">
      <h2 class="how__title" id="how-title">{home.how.title}</h2>
      <ol class="steps" role="list">
        {
          home.how.steps.map((step, i) => (
            <li class="step">
              <div class="step__shot">
                <Screenshot src={SCREENSHOTS[step.id]} alt={step.shotAlt} placeholder={copy.common.screenshotPlaceholder} />
              </div>
              <div class="step__text">
                <span class="step__num" aria-hidden="true">{i + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="how__foot">
        <a class="text-link" href={localePath(lang, '/features')}>{home.how.link}</a>
        <p class="how__note">{home.how.demoNote}</p>
      </div>
    </div>
    <svg class="wave wave--bottom" viewBox="0 0 1440 48" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 48V24C190 2 380 42 640 27S1130 0 1440 21V48Z" fill="currentColor"></path>
    </svg>
  </section>

  <!-- 3. Real examples: activity cards from the app's own library -->
  <section class="section examples" id="example" aria-labelledby="examples-title">
    <div class="container">
      <h2 class="section-title" id="examples-title">{home.examples.title}</h2>
      <ul class="cards" role="list">
        {
          home.examples.cards.map((card) => (
            <li class="card">
              <Figure class="card__photo" image={IMAGES[card.image as keyof typeof IMAGES]} alt={card.imageAlt} placeholder={copy.common.imagePlaceholder} />
              <div class="card__body">
                <h3>{card.title}</h3>
                <p class="card__meta">
                  <span>{card.age}</span>
                  <span>{home.examples.minutes.replace('{n}', String(card.minutes))}</span>
                </p>
                <p class="card__label">{home.examples.materialsLabel}</p>
                <ul class="card__materials" role="list">
                  {card.materials.map((material) => <li>{material}</li>)}
                </ul>
                <p class="card__label">{home.examples.stepsLabel}</p>
                <ol class="card__steps">
                  {card.steps.map((step) => <li>{step}</li>)}
                </ol>
              </div>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--go examples__cta" href="#invite">{copy.common.cta}<span aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- 4. Who it's for -->
  <section class="section section--cream who" id="who" aria-labelledby="who-title">
    <div class="container">
      <h2 class="section-title" id="who-title">{home.who.title}</h2>
      <ul class="who__cards" role="list">
        {
          home.who.cards.map((card) => (
            <li class="who__card">
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </li>
          ))
        }
      </ul>
      <p class="who__why">
        {home.who.why}
        <a class="text-link" href={localePath(lang, '/philosophy')}>{home.who.link}</a>
      </p>
    </div>
  </section>

  <!-- 5. The founder strip, then the invite form -->
  <section class="section section--tight founder" id="founder" aria-labelledby="founder-title">
    <div class="container founder__strip">
      <div class="founder__art">
        <span class="founder__patch" aria-hidden="true"></span>
        <Figure class="founder__photo" image={IMAGES.founderPortrait} alt={home.founder.imageAlt} placeholder={copy.common.imagePlaceholder} />
      </div>
      <div class="founder__text">
        <h2 class="kicker" id="founder-title"><Botanical name="sprig" />{home.founder.title}</h2>
        <p class="founder__body">{home.founder.body}</p>
        <a class="text-link" href={localePath(lang, '/about')}>{home.founder.link}</a>
      </div>
    </div>
  </section>

  <section class="section section--sage invite" id="invite" aria-labelledby="invite-title">
    <div class="container container--narrow invite__inner">
      <h2 class="section-title" id="invite-title">{home.invite.title}</h2>
      <p class="invite__body">{home.invite.body}</p>
      {
        formUrl ? (
          <iframe class="invite__frame" src={formUrl} title={home.invite.formTitle} loading="lazy" />
        ) : (
          SHOW_DESIGN_PLACEHOLDERS && (
            <p class="draft-note">
              <span class="tag tag--draft">{copy.common.placeholder}</span>
              <span>{home.invite.setup}</span>
            </p>
          )
        )
      }
      <a class="text-link" href={localePath(lang, '/privacy')}>{home.invite.privacy}</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Shared pieces */
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--green-600);
    font-size: var(--step--1);
    font-weight: 700;
  }
  .kicker :global(.botanical) {
    width: 1.75rem;
    flex-shrink: 0;
    transition: transform 0.5s var(--ease);
    transform-origin: 10% 90%;
  }
  section:hover .kicker :global(.botanical) {
    transform: rotate(-8deg);
  }

  /* Section headings: a label, a title and a line or two of introduction */
  .head {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    margin-bottom: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }
  .head__title {
    font-size: var(--step-4);
  }
  .head__intro {
    max-width: 36rem;
    color: var(--ink-soft);
    font-size: var(--step-1);
    line-height: 1.6;
  }
  .head--center {
    justify-items: center;
    text-align: center;
  }

  /* Photographs: soft shapes on a quiet placeholder */
  section :global(.figure) {
    --figure-radius: 1.5rem;
    --figure-placeholder-bg: var(--cream-200);
    --figure-placeholder-ink: var(--line-strong);
  }
  section :global(.figure img) {
    transition: transform 0.9s var(--ease);
  }

  /* A button with an arrow that moves a little on hover */
  .btn--go span {
    transition: transform 0.25s var(--ease);
  }
  .btn--go:hover span {
    transform: translateX(3px);
  }
  .btn--down:hover span {
    transform: translateY(3px);
  }
  .btn:active {
    transform: translateY(1px);
  }

  /* A plain section title, as on the other pages */
  .section-title {
    font-size: var(--step-3);
  }

  /* Hero */
  .hero {
    padding-block: clamp(2rem, 1rem + 4vw, 4.5rem) clamp(3rem, 2rem + 4vw, 6rem);
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    gap: var(--space-8);
  }
  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }
  .hero__title {
    display: flex;
    flex-direction: column;
    font-size: clamp(2.9rem, 1.4rem + 6.4vw, 5.4rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-wrap: initial;
  }
  .hero__line {
    white-space: nowrap;
  }
  .hero__line:last-child {
    padding-left: 0.5em;
    font-style: italic;
    font-weight: 400;
    color: var(--terracotta-700);
  }
  :lang(zh) .hero__title {
    font-size: clamp(2.6rem, 1.2rem + 5.4vw, 4.6rem);
    line-height: 1.25;
    letter-spacing: 0.02em;
  }
  :lang(zh) .hero__line:last-child {
    font-style: normal;
  }
  .hero__lead {
    max-width: 31rem;
    color: var(--ink-soft);
    font-size: var(--step-1);
    line-height: 1.6;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
  .hero__actions .text-link {
    margin-left: var(--space-2);
  }
  /* The small line about early access, under the button */
  .hero__access {
    margin-top: calc(-1 * var(--space-2));
    color: var(--muted);
    font-size: var(--step--1);
  }
  /* The layered picture: the photograph at the back, the app leaning over its lower corner, a vine up the far side */
  .hero__art {
    position: relative;
    z-index: 0;
    padding: 0 6% 7% 20%;
  }
  .hero__patch {
    position: absolute;
    z-index: -1;
    inset: 14% -10% 0 4%;
    border-radius: 58% 42% 55% 45% / 48% 56% 44% 52%;
    background: var(--sage-100);
  }
  .hero__sun {
    position: absolute;
    z-index: -1;
    top: -4%;
    right: -3%;
    width: 30%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--gold-100);
  }
  section :global(.hero__media) {
    --figure-radius: 999px 999px 1.5rem 1.5rem;
  }
  :global(.hero__media .figure__label) {
    left: auto;
    right: 1rem;
    text-align: right;
  }
  .hero__shot {
    position: absolute;
    left: 5%;
    bottom: 0;
    width: 36%;
    transform: rotate(-6deg);
    transform-origin: 50% 100%;
    transition: transform 0.6s var(--ease);
  }
  .hero__art:hover .hero__shot {
    transform: rotate(-3deg) translateY(-4px);
  }
  .hero__shot :global(.shot) {
    max-width: none;
  }
  .hero__shot :global(.shot img) {
    border-radius: clamp(1rem, 2.4vw, 1.75rem);
    box-shadow:
      0 1px 2px rgba(43, 37, 32, 0.08),
      0 28px 48px -22px rgba(35, 58, 46, 0.5);
  }
  :global(.hero__vine) {
    position: absolute;
    right: -6%;
    bottom: 2%;
    width: 36%;
    transform: scaleX(-1);
  }
  @media (max-width: 35.99em) {
    .hero__actions {
      width: 100%;
      gap: var(--space-4);
    }
    .hero__actions .btn {
      flex: 1 1 100%;
      min-height: 3.25rem;
    }
    .hero__actions .text-link {
      margin-left: 0;
    }
  }
  @media (min-width: 56em) {
    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-5);
      align-items: center;
    }
    .hero__text {
      grid-column: 1 / 7;
      gap: var(--space-6);
    }
    .hero__title {
      font-size: clamp(2.9rem, 0.4rem + 4.6vw, 4.75rem);
    }
    :lang(zh) .hero__title {
      font-size: clamp(2.6rem, 0.4rem + 4.2vw, 4.25rem);
    }
    .hero__art {
      grid-column: 7 / -1;
    }
  }

  /* How it works */
  .how {
    position: relative;
  }
  .wave {
    position: absolute;
    left: 0;
    z-index: 1;
    width: 100%;
    height: clamp(18px, 3.4vw, 48px);
    color: var(--green-800);
    pointer-events: none;
  }
  .wave--top {
    top: 1px;
    transform: translateY(-100%);
  }
  .wave--bottom {
    bottom: 1px;
    transform: translateY(100%) rotate(180deg);
  }
  .how__inner {
    position: relative;
  }
  :global(.how__vine) {
    position: absolute;
    top: 0;
    right: 0;
    width: clamp(4.5rem, 11vw, 10rem);
    --bot-stem: rgba(201, 214, 198, 0.34);
    --bot-leaf-a: rgba(201, 214, 198, 0.2);
    --bot-leaf-b: rgba(201, 214, 198, 0.12);
    --bot-leaf-c: rgba(75, 124, 99, 0.6);
    --bot-terra: rgba(217, 139, 98, 0.65);
  }
  .how__title {
    font-size: var(--step-4);
  }
  /* Phones: one step under another, a slice of each screen beside its words */
  .steps {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }
  .step {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: var(--space-5);
    align-items: center;
  }
  .step__shot :global(.shot img),
  .step__shot :global(.shot__placeholder) {
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 0;
    border-radius: 0.9rem;
    border-color: rgba(248, 241, 230, 0.22);
    box-shadow: 0 18px 30px -18px rgba(0, 0, 0, 0.6);
  }
  .step__text {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-1) var(--space-3);
    align-items: center;
  }
  .step__num {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--gold-400);
    color: var(--green-800);
    font-size: var(--step--2);
    font-weight: 700;
  }
  .step h3 {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    font-weight: 500;
    color: var(--white);
  }
  :lang(zh) .step h3 {
    font-family: var(--font-serif-zh);
    font-weight: 600;
  }
  .step p {
    grid-column: 1 / -1;
    color: rgba(250, 238, 220, 0.86);
  }
  .how__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-6);
  }
  .how__note {
    color: rgba(250, 238, 220, 0.72);
    font-size: var(--step--2);
  }
  /* Wide screens: all four in one row, each with its whole screen above its words */
  @media (min-width: 56em) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-6);
      margin-top: var(--space-7);
    }
    .step {
      grid-template-columns: 1fr;
      gap: var(--space-5);
      align-content: start;
      justify-items: start;
    }
    .step__shot {
      width: 100%;
      max-width: 13rem;
    }
    .step__shot :global(.shot img),
    .step__shot :global(.shot__placeholder) {
      aspect-ratio: 585 / 1266;
      border-radius: 1.6rem;
    }
    .how__note {
      margin-left: auto;
    }
  }

  /* Real examples: activity cards */
  .cards {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }
  .card {
    display: grid;
    align-content: start;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 1.5rem;
    background: var(--white);
  }
  .card :global(.card__photo) {
    --figure-radius: 0;
  }
  .card__body {
    display: grid;
    gap: var(--space-3);
    padding: clamp(1.25rem, 1rem + 1.2vw, 2rem);
  }
  .card h3 {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    font-weight: 500;
  }
  :lang(zh) .card h3 {
    font-family: var(--font-serif-zh);
    font-weight: 600;
  }
  .card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .card__meta span {
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: var(--gold-100);
    color: var(--ink-soft);
    font-size: var(--step--2);
    font-weight: 700;
  }
  .card__label {
    margin-top: var(--space-2);
    color: var(--terracotta-700);
    font-size: var(--step--2);
    font-weight: 700;
  }
  .card__materials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .card__materials li {
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--sage-300);
    border-radius: 999px;
    background: var(--sage-100);
    color: var(--green-700);
    font-size: var(--step--1);
  }
  .card__steps {
    display: grid;
    gap: var(--space-2);
    padding-left: 1.25rem;
    color: var(--ink-soft);
  }
  .card__steps li::marker {
    color: var(--green-500);
    font-weight: 700;
  }
  .examples__cta {
    margin-top: var(--space-6);
  }
  @media (min-width: 48em) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
  @media (max-width: 35.99em) {
    /* Phones: a wider, shorter crop keeps each card to about one screen */
    .card :global(.card__photo) {
      --figure-ratio: 16 / 9;
    }
    .examples__cta {
      width: 100%;
      min-height: 3.25rem;
    }
  }

  /* Who it's for */
  .who__cards {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
  .who__card {
    padding: clamp(1.25rem, 1rem + 1.2vw, 2rem);
    border-radius: 1.5rem 1.5rem 1.5rem 3.5rem;
    background: var(--paper);
  }
  .who__card:nth-child(2) {
    border-radius: 1.5rem;
  }
  .who__card:nth-child(3) {
    border-radius: 1.5rem 1.5rem 3.5rem 1.5rem;
  }
  .who__card h3 {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    font-weight: 500;
  }
  :lang(zh) .who__card h3 {
    font-family: var(--font-serif-zh);
    font-weight: 600;
  }
  .who__card p {
    margin-top: var(--space-2);
    color: var(--ink-soft);
  }
  .who__why {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-6);
    color: var(--ink-soft);
  }
  @media (min-width: 48em) {
    .who__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }

  /* The founder strip: a small portrait beside two sentences */
  .founder__strip {
    display: grid;
    grid-template-columns: clamp(5.5rem, 22vw, 9rem) 1fr;
    gap: var(--space-5) clamp(1.5rem, 1rem + 3vw, 3.5rem);
    align-items: center;
    max-width: 52rem;
  }
  .founder__art {
    position: relative;
    isolation: isolate;
  }
  .founder__patch {
    position: absolute;
    z-index: -1;
    inset: -7% -9% -5%;
    border-radius: 45% 55% 42% 58% / 56% 44% 56% 44%;
    background: var(--sage-200);
    transform: rotate(-9deg);
  }
  section :global(.founder__photo) {
    --figure-radius: 48% 52% 46% 54% / 55% 44% 56% 45%;
    --figure-placeholder-bg: var(--white);
  }
  :global(.founder__photo .figure__label code) {
    display: none;
  }
  .founder__text {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  .founder__text .kicker {
    font-family: var(--font-sans);
  }
  :lang(zh) .founder__text .kicker {
    font-family: var(--font-sans-zh);
  }
  .founder__body {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--green-700);
    text-wrap: pretty;
  }
  :lang(zh) .founder__body {
    font-family: var(--font-serif-zh);
    line-height: 1.8;
  }

  /* The invite form: a hosted form in a frame */
  .invite {
    /* Clear of the sticky header when a "Request an invite" link jumps here */
    scroll-margin-top: var(--header-h);
  }
  .invite__inner {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }
  .invite__body {
    color: var(--ink-soft);
    font-size: var(--step-1);
    line-height: 1.6;
  }
  /* Hosted forms do not report their height, so the frame is given room for four questions and scrolls beyond that.
     Adjust --invite-frame-h once the real forms are in. */
