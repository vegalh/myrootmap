---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import ResourceItem from '../components/ResourceItem.astro';
import EmptyState from '../components/EmptyState.astro';
import { t, type Lang } from '../i18n';
import { getResources } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
const page = copy.resources;
const resources = await getResources();
const categories = Object.entries(copy.categories.resources) as [keyof typeof copy.categories.resources, { title: string; body: string }][];
const byCategory = categories
  .map(([key, cat]) => ({ key, ...cat, items: resources.filter((r) => r.data.category === key) }))
  .filter((group) => group.items.length > 0);
const count = (n: number) => (n === 1 ? page.countOne : page.countMany.replace('{n}', String(n)));
---

<BaseLayout lang={lang} title={page.title} description={page.description}>
  <PageIntro eyebrow={page.eyebrow} title={page.heading} lead={page.lead} />

  <section class="section section--cream bookshelf" id="bookshelf" aria-labelledby="bookshelf-title">
    <div class="container">
      <header class="bookshelf__head">
        <h2 id="bookshelf-title">{copy.bookshelf.title}</h2>
        <p>{copy.bookshelf.intro}</p>
      </header>
      <ul class="bookshelf__list" role="list">
        {copy.bookshelf.books.map((book) => (
          <li class="book">
            <div class="book__cover" aria-hidden="true"><span>{book.title}</span><span>{book.author}</span></div>
            <div class="book__details">
              <h3>{book.title}</h3>
              <p class="book__author">{book.author}</p>
              <p>{book.note}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      {
        resources.length === 0 ? (
          <div class="empty">
            <EmptyState title={page.empty.title} body={page.empty.body} />
            <h2 class="cats__title">{page.categoriesLabel}</h2>
            <ul class="cats" role="list">
              {categories.map(([, cat]) => (
                <li>
                  <h3>{cat.title}</h3>
                  <p>{cat.body}</p>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <div class="library">
            <nav class="library__nav" aria-label={page.categoriesLabel}>
              <ul role="list">
                {byCategory.map((group) => (
                  <li>
                    <a href={`#${group.key}`}>
                      {group.title} <span>{group.items.length}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
            <div class="library__groups">
              {byCategory.map((group) => (
                <section class="group" aria-labelledby={group.key}>
                  <header class="group__head">
                    <h2 id={group.key}>{group.title}</h2>
                    <p>
                      {group.body} <span class="muted">· {count(group.items.length)}</span>
                    </p>
                  </header>
                  <ul class="group__items" role="list">
                    {group.items.map((resource) => (
                      <ResourceItem resource={resource} lang={lang} />
                    ))}
                  </ul>
                </section>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .bookshelf__head {
    max-width: 42rem;
    margin-bottom: var(--space-6);

  }
  .bookshelf__head h2 {
    font-family: var(--font-serif);
    font-size: var(--step-4);
    font-weight: 500;
    margin-bottom: var(--space-3);

  }
  :lang(zh) .bookshelf__head h2 {
    font-family: var(--font-serif-zh);

  }
  .bookshelf__head p, .book__details p {
    color: var(--ink-soft);

  }
  .bookshelf__list {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 25rem), 1fr));

  }
  .book {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-bottom: 2px solid var(--sage-300);

  }
  .book__cover {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 2 / 3;
    padding: 1rem 0.75rem 1rem 1rem;
    border-left: 5px solid var(--green-800);
    border-radius: 2px 8px 8px 2px;
    background: var(--green-700);
    color: var(--cream-100);
    box-shadow: var(--shadow-sm);
    transform: rotate(-3deg);

  }
  .book__cover span:first-child {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.2;

  }
  .book__cover span:last-child {
    font-size: 0.75rem;

  }
  .book__details h3 {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    font-weight: 500;

  }
  .book__author {
    margin-block: var(--space-1) var(--space-3);
    font-size: var(--step--1);

  }
  @media (max-width: 25em) {
    .book {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: var(--space-4);
    }
  }

  .cats__title {
    margin: var(--space-8) 0 var(--space-5);
    font-size: var(--step-2);
  }
  .cats {
    display: grid;
    border-top: 1px solid var(--line-strong);
  }
  .cats li {
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--line);
  }
  .cats h3 {
    font-size: var(--step-1);
  }
  .cats p {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }
  @media (min-width: 48em) {
    .cats {
      grid-template-columns: repeat(2, 1fr);
      column-gap: var(--space-6);
    }
  }
  @media (min-width: 64em) {
    .cats {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .library {
    display: grid;
    gap: var(--space-7);
  }
  .library__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .library__nav a {
    display: inline-flex;
    gap: var(--space-2);
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
  }
  .library__nav a:hover {
    border-color: var(--green-500);
    color: var(--green-700);
  }
  .library__nav span {
    color: var(--muted);
    font-weight: 400;
  }
  .group + .group {
    margin-top: var(--space-8);
  }
  .group__head {
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--line);
  }
  .group__head h2 {
    font-size: var(--step-3);
  }
  .group__head p {
    margin-top: var(--space-2);
    color: var(--ink-soft);
  }
  .group__items {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 48em) {
    .group__items {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64em) {
    .library {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: var(--space-8);
    }
    .library__nav {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      align-self: start;
    }
    .library__nav ul {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
